# Copy to the server (e.g. `/home/henry/romp-crm/.env.production`), chmod 600, fill in secrets.
# Reference: deploy/README.md and config/runtime.exs
#
# Required for production (see config/runtime.exs)

MIX_ENV=prod
PHX_SERVER=true
PORT=40175

PHX_HOST=hromp.com

# Generate a new value on any machine with Elixir:  mix phx.gen.secret
SECRET_KEY_BASE=

# SQLite path on the server (directory must exist and be writable)
DATABASE_PATH=/home/henry/romp-crm/data/romp_crm.db

# Persistent job photo storage (survives mix release upgrades; default: var/static under repo root)
# JOB_PHOTO_STATIC_DIR=/home/henry/romp-crm/var/static

# Optional pool size (default 5)
# POOL_SIZE=5

# --- Mail (required in production: runtime raises if MAIL_FROM_ADDRESS / SMTP missing) ---
# MAIL_FROM_NAME=Romp CRM
# MAIL_FROM_ADDRESS=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=always
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=

# --- Twilio + Anthropic (SMS / AI job extraction) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_FROM=+18022780965
# If this number is on a Messaging Service, run: mix twilio.messaging_service_inbound (needs SID below)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_SMS_REPLIES_ENABLED=true
# Customer scheduling agent SMS (invites, confirmations, slot offers). Default off.
# CUSTOMER_SCHEDULING_SMS_ENABLED=false
# ANTHROPIC_API_KEY=
# TWILIO_WEBHOOK_PUBLIC_URL=https://hromp.com/romp-crm/webhooks/twilio/sms
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional Twilio voice (see deploy/README.md)
# TWILIO_VOICE_WEBHOOK_PUBLIC_URL=https://hromp.com/romp-crm/webhooks/twilio/voice
# TWILIO_VOICE_FORWARD_TO=+18024587299

# --- Access control ---
# ALLOWED_REGISTRATION_EMAILS=...   # only used when ENFORCE_REGISTRATION_ALLOWLIST=true
# ENFORCE_REGISTRATION_ALLOWLIST=false
# TWILIO_SMS_ALLOWED_FROM=+18024587299,+18024582710,+18022780965

# --- Hosted PayPal paywall (leave OFF for typical self-host) ---
# When false or unset, new users are active without PayPal. When true, you need full PayPal env (see deploy/README.md).
# SUBSCRIPTION_PAYWALL_ENABLED=false
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=live
# PAYPAL_PLAN_MONTHLY_ID=
# PAYPAL_PLAN_ANNUAL_ID=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_TRIAL_DAYS=0
# SIGNUP_TRIAL_DAYS=30

# --- Google Maps Platform (optional — job address autocomplete + geocode validation) ---
# Without this key, structured address fields still work; Places Autocomplete and
# “Check address” are hidden. See docs/self-hosting-rompcrm.com.html §4 and README.md.
# Enable on the key: Maps JavaScript API, Places API, Geocoding API. Restrict by HTTP referrer.
# GOOGLE_MAPS_API_KEY=

# --- Customer self-scheduling (booking links) ---
# Public short URL clients see in SMS (nginx proxies /book/ to the app).
# BOOKING_LINK_BASE_URL=https://rompcrm.com/book

# --- Google Calendar free/busy (Settings -> Connected calendars; optional) ---
# Google Cloud OAuth client (Web application). Scope used: calendar.freebusy (read-only).
# Authorized redirect URI: <GOOGLE_CALENDAR_REDIRECT_BASE>/users/settings/calendars/google/callback
# Without these, the Connect Google button is hidden. Apple Calendar (CalDAV
# app-specific password) needs no server config.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_BASE=https://hromp.com/romp-crm
# Optional dedicated encryption key for stored calendar credentials
# (defaults to a key derived from SECRET_KEY_BASE):
# CALENDAR_CREDENTIALS_KEY=

# --- Admin dashboard (/admin) ---
# ADMIN_EMAILS=you@example.com
# SIGNUP_NOTIFY_EMAILS=you@example.com

# --- Transactional email branding (optional overrides) ---
# EMAIL_LOGO_URL=https://rompcrm.com/media/romp-crm-logo-main-dark.png
# EMAIL_BRAND_BASE_URL=https://rompcrm.com
