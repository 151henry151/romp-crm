# Step 2 — Copy to the server (e.g. /etc/jgs-crm/jgs-crm.env), chmod 600, fill in secrets.
# Reference: deploy/README.md
#
# Required for production (see config/runtime.exs)

MIX_ENV=prod
PHX_SERVER=true
PORT=4000

PHX_HOST=hromp.com

# Generate a new value on any machine with Elixir:  mix phx.gen.secret
SECRET_KEY_BASE=

# SQLite path on the server (directory must exist and be writable)
DATABASE_PATH=/var/lib/jgs-crm/jgs_crm.db

# Optional pool size (default 5)
# POOL_SIZE=5

# Twilio + Anthropic — add when you configure SMS (step 3)
# TWILIO_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
# TWILIO_WEBHOOK_PUBLIC_URL=https://hromp.com/jgs-crm/webhooks/twilio/sms
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
