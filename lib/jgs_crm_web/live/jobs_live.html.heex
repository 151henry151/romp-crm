<div class="min-h-screen bg-gray-50">
  <%!-- Header --%>
  <header class="bg-white border-b border-gray-200 px-6 py-4">
    <div class="flex items-center justify-between max-w-screen-xl mx-auto">
      <div>
        <h1 class="text-xl font-bold text-gray-900">JGS Mechanical</h1>
        <p class="text-sm text-gray-500">Customer & Job Tracker</p>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-sm text-gray-500"><%= @current_scope.user.email %></span>
        <.link href={~p"/users/log-out"} method="delete" class="text-sm text-gray-500 hover:text-gray-900">
          Log out
        </.link>
        <.link patch={~p"/jobs/new"} class="inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500">
          + New Job
        </.link>
      </div>
    </div>
  </header>

  <main class="max-w-screen-xl mx-auto px-6 py-6">
    <%!-- Status filter tabs --%>
    <div class="flex gap-1 mb-6 border-b border-gray-200">
      <%= for {label, status} <- [{"All", :all} | Enum.map([:lead, :pending, :in_progress, :done], &{status_label(&1), &1})] do %>
        <button
          phx-click="filter"
          phx-value-status={status}
          class={[
            "px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors",
            if(@filter == status,
              do: "border-blue-600 text-blue-600",
              else: "border-transparent text-gray-500 hover:text-gray-700"
            )
          ]}
        >
          <%= label %>
          <span class={[
            "ml-1.5 rounded-full px-1.5 py-0.5 text-xs",
            if(@filter == status, do: "bg-blue-100 text-blue-700", else: "bg-gray-100 text-gray-600")
          ]}>
            <%= count_for(@jobs, status) %>
          </span>
        </button>
      <% end %>
    </div>

    <%!-- Job table --%>
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50">
            <th class="text-left px-4 py-3 font-medium text-gray-600">Client</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Address</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Phone</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Work</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Priority</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Status</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Referred By</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Next Action</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <%= for job <- visible_jobs(@jobs, @filter) do %>
            <tr class="hover:bg-gray-50 group">
              <td class="px-4 py-3 font-medium text-gray-900 whitespace-nowrap">
                <%= job.client_name %>
              </td>
              <td class="px-4 py-3 text-gray-600 max-w-[150px] truncate"><%= job.address %></td>
              <td class="px-4 py-3 text-gray-600 whitespace-nowrap"><%= job.phone %></td>
              <td class="px-4 py-3 text-gray-700 max-w-[220px]">
                <span class="line-clamp-2"><%= job.work_description %></span>
              </td>
              <td class="px-4 py-3">
                <%= if job.priority == :high do %>
                  <span class={"rounded-full px-2 py-0.5 text-xs font-semibold #{priority_class(job.priority)}"}>
                    HIGH
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <span class={"rounded-full px-2.5 py-0.5 text-xs font-medium #{status_class(job.status)}"}>
                  <%= status_label(job.status) %>
                </span>
              </td>
              <td class="px-4 py-3 text-gray-600"><%= job.referred_by %></td>
              <td class="px-4 py-3 text-gray-600 max-w-[150px] truncate"><%= job.next_action %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                  <.link patch={~p"/jobs/#{job.id}/edit"} class="text-blue-600 hover:text-blue-800 font-medium">
                    Edit
                  </.link>
                  <button
                    phx-click="delete"
                    phx-value-id={job.id}
                    data-confirm="Delete this job?"
                    class="text-red-500 hover:text-red-700 font-medium"
                  >
                    Delete
                  </button>
                </div>
              </td>
            </tr>
          <% end %>
          <%= if visible_jobs(@jobs, @filter) == [] do %>
            <tr>
              <td colspan="9" class="px-4 py-12 text-center text-gray-400">
                No jobs found.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<%!-- Modal for new/edit --%>
<%= if @live_action in [:new, :edit] do %>
  <.modal id="job-modal" show on_cancel={JS.patch(~p"/")}>
    <.live_component
      module={JgsCrmWeb.JobFormComponent}
      id={@job.id || :new}
      title={if @live_action == :new, do: "New Job", else: "Edit Job"}
      action={@live_action}
      job={@job}
      patch={~p"/"}
    />
  </.modal>
<% end %>
