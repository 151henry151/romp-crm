<Layouts.app flash={@flash} current_scope={@current_scope} content_width={:wide}>
  <div>
    <div class="mb-6 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-xl font-semibold">Employees</h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <.link navigate={~p"/"} class="text-sm font-medium text-blue-600 hover:text-blue-800">
          Jobs
        </.link>
        <.link
          navigate={~p"/time-log"}
          class="text-sm font-medium text-blue-600 hover:text-blue-800"
        >
          Time Log
        </.link>
        <.link
          patch={~p"/employees/new"}
          class="inline-flex h-9 min-h-[2.25rem] items-center justify-center rounded-lg bg-blue-600 px-4 text-sm font-semibold text-white no-underline shadow-sm hover:bg-blue-500"
        >
          + New Employee
        </.link>
      </div>
    </div>

    <%= if @employees == [] do %>
      <div
        id="employees-empty"
        class="rounded-lg border border-base-300 bg-base-100 px-4 py-12 text-center text-base-content/60"
      >
        No employees yet. Add team members to track their time.
      </div>
    <% else %>
      <%!-- Mobile: stacked cards (no horizontal scroll) --%>
      <div class="md:hidden space-y-3">
        <%= for emp <- @employees do %>
          <div class="rounded-lg border border-base-300 bg-base-100 px-4 py-3 space-y-3">
            <p class="font-semibold text-base-content break-words">
              <.link
                navigate={~p"/employees/#{emp.id}"}
                class="text-blue-600 hover:text-blue-800"
              >
                {emp.name}
              </.link>
            </p>
            <dl class="space-y-2 text-sm text-base-content/80">
              <div>
                <dt class="font-medium text-base-content/90">Title</dt>
                <dd class="mt-0.5 break-words">{display_cell(emp.title)}</dd>
              </div>
              <div>
                <dt class="font-medium text-base-content/90">Phone</dt>
                <dd class="mt-0.5 break-words">{display_cell(emp.phone)}</dd>
              </div>
              <div>
                <dt class="font-medium text-base-content/90">Email</dt>
                <dd class="mt-0.5 break-words">{display_cell(emp.email)}</dd>
              </div>
            </dl>
              <div class="flex flex-wrap items-center gap-4 pt-2 border-t border-base-300">
                <.link
                  patch={~p"/employees/#{emp.id}/edit"}
                  class="text-blue-600 hover:text-blue-800 font-medium text-sm"
                >
                  Edit
                </.link>
                <%= if is_nil(emp.user_id) && emp.email && String.trim(to_string(emp.email)) != "" do %>
                  <button
                    type="button"
                    phx-click="invite_to_app"
                    phx-value-id={emp.id}
                    class="text-blue-600 hover:text-blue-800 font-medium text-sm"
                  >
                    Invite to app
                  </button>
                <% end %>
                <button
                type="button"
                id={"delete-employee-sm-#{emp.id}"}
                phx-click="delete"
                phx-value-id={emp.id}
                data-confirm="Delete this employee?"
                class="text-red-500 hover:text-red-700 font-medium text-sm"
              >
                Delete
              </button>
            </div>
          </div>
        <% end %>
      </div>

      <%!-- Desktop: table --%>
      <div class="hidden md:block rounded-lg border border-base-300 bg-base-100 overflow-hidden">
        <table class="w-full text-sm" id="employees-table">
          <thead>
            <tr class="border-b border-base-300 bg-base-200/40">
              <th class="text-left px-4 py-3 font-medium text-base-content/80">Name</th>
              <th class="text-left px-4 py-3 font-medium text-base-content/80">Title</th>
              <th class="text-left px-4 py-3 font-medium text-base-content/80">Phone</th>
              <th class="text-left px-4 py-3 font-medium text-base-content/80">Email</th>
              <th class="text-left px-4 py-3 font-medium text-base-content/80">App</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-base-300">
            <%= for emp <- @employees do %>
              <tr id={"employee-row-#{emp.id}"} class="hover:bg-base-200/40 group">
                <td class="px-4 py-3 font-medium text-base-content">
                  <.link
                    navigate={~p"/employees/#{emp.id}"}
                    class="text-blue-600 hover:text-blue-800"
                  >
                    {emp.name}
                  </.link>
                </td>
                <td class="px-4 py-3 text-base-content/80">{emp.title}</td>
                <td class="px-4 py-3 text-base-content/80">{emp.phone}</td>
                <td class="px-4 py-3 text-base-content/80">{emp.email}</td>
                <td class="px-4 py-3 text-base-content/80 text-xs">
                  <%= if emp.user_id do %>
                    Linked
                  <% else %>
                    <span class="text-base-content/50">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <%= if is_nil(emp.user_id) && emp.email && String.trim(to_string(emp.email)) != "" do %>
                      <button
                        type="button"
                        phx-click="invite_to_app"
                        phx-value-id={emp.id}
                        class="text-blue-600 hover:text-blue-800 font-medium text-xs"
                      >
                        Invite
                      </button>
                    <% end %>
                    <.link
                      patch={~p"/employees/#{emp.id}/edit"}
                      class="text-blue-600 hover:text-blue-800 font-medium"
                    >
                      Edit
                    </.link>
                    <button
                      id={"delete-employee-#{emp.id}"}
                      phx-click="delete"
                      phx-value-id={emp.id}
                      data-confirm="Delete this employee?"
                      class="text-red-500 hover:text-red-700 font-medium"
                    >
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</Layouts.app>

<%!-- Modal for new/edit employee --%>
<%= if @live_action in [:new, :edit] do %>
  <.modal id="employee-modal" show on_cancel={JS.patch(~p"/employees")}>
      <.live_component
        module={RompCrmWeb.EmployeeFormComponent}
        id={(@employee && @employee.id) || :new}
        title={if @live_action == :new, do: "New Employee", else: "Edit Employee"}
        action={@live_action}
        employee={@employee}
        current_business_id={@current_business_id}
        actor_user_id={@current_scope.user.id}
        patch={~p"/employees"}
      />
  </.modal>
<% end %>
