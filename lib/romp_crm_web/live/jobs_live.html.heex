<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  socket={@socket}
  show_sms_assistant_intro_modal={@show_sms_assistant_intro_modal}
  show_workspace_nav={true}
  current_business_id={@current_business_id}
  my_businesses={@my_businesses}
  is_business_owner={@is_business_owner}
  content_width={:wide}
>
  <div class="text-base-content">
    <%!-- Filter / sort controls + new job --%>
    <div class="mb-6 flex flex-wrap items-center gap-2 border-b border-base-300 pb-3">
      <div class="relative min-w-0 flex-1">
        <div class="relative flex flex-wrap items-center gap-2">
        <details class="group">
          <summary
            class={[
              "indicator btn btn-square btn-sm h-9 w-9 min-h-0 shrink-0 list-none cursor-pointer border bg-base-100 p-0 text-base-content shadow-sm hover:bg-base-200 [&::-webkit-details-marker]:hidden",
              if(JobsList.filter_active?(@filter),
                do: "border-base-content/35 bg-base-300/40 hover:border-base-content/45 hover:bg-base-300/55 dark:bg-base-300/30 dark:hover:bg-base-300/45",
                else: "border-base-content/20 hover:border-base-content/30"
              )
            ]}
            aria-label={JobsList.filter_button_label(@filter, @color_code_statuses)}
            title={JobsList.filter_button_label(@filter, @color_code_statuses)}
          >
            <%= if JobsList.filter_active?(@filter) do %>
              <span class="indicator-item status status-neutral status-xs" aria-hidden="true"></span>
            <% end %>
            <.icon name="hero-funnel" class="size-4 shrink-0 text-base-content" />
          </summary>
          <div class="absolute left-0 right-0 top-full z-30 mt-1 w-full rounded-lg border border-base-300 bg-base-100 p-1.5 shadow-lg">
            <%= for {label, status} <- JobsList.filter_options() do %>
              <button
                type="button"
                phx-click="filter"
                phx-value-status={status}
                class={[
                  "flex w-full items-center justify-between gap-3 rounded-md px-3 py-2 text-left text-sm whitespace-nowrap",
                  if(@filter == status,
                    do: "bg-base-200 font-semibold text-base-content",
                    else: "hover:bg-base-200/60 text-base-content/80"
                  )
                ]}
              >
                <span>{label}</span>
                <span class="text-xs tabular-nums text-base-content/60">{JobsList.count_for(@jobs, status)}</span>
              </button>
            <% end %>
            <div class="mt-1.5 border-t border-base-300 pt-1.5">
              <label class="flex cursor-pointer items-start gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-base-200/60 whitespace-nowrap">
                <input
                  type="checkbox"
                  checked={@color_code_statuses}
                  phx-click="toggle_color_code"
                  class="checkbox checkbox-sm mt-0.5"
                />
                <span class="font-medium text-base-content">Color-code</span>
              </label>
            </div>
          </div>
        </details>

        <details class="group">
          <summary
            class="btn btn-square btn-sm h-9 w-9 min-h-0 shrink-0 list-none cursor-pointer border border-base-content/20 bg-base-100 p-0 text-base-content shadow-sm hover:border-base-content/30 hover:bg-base-200 [&::-webkit-details-marker]:hidden"
            aria-label={JobsList.sort_summary(@sort_by, @show_address_primary)}
            title={JobsList.sort_summary(@sort_by, @show_address_primary)}
          >
            <.icon name="hero-bars-3-bottom-left" class="size-4 shrink-0 text-base-content" />
          </summary>
          <div class="absolute left-0 right-0 top-full z-30 mt-1 w-full rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg">
            <div class="space-y-0.5">
              <p class="px-2 text-xs font-medium uppercase tracking-wide text-base-content/50">Sort by</p>
              <%= for {label, key} <- JobsList.sort_options() do %>
                <button
                  type="button"
                  phx-click="set_sort"
                  phx-value-sort={key}
                  class={[
                    "block w-full rounded-md px-3 py-2 text-left text-sm whitespace-nowrap",
                    if(@sort_by == key,
                      do: "bg-base-200 font-semibold text-base-content",
                      else: "hover:bg-base-200/60 text-base-content/80"
                    )
                  ]}
                >
                  {label}
                </button>
              <% end %>
            </div>
            <div class="mt-2 border-t border-base-300 pt-2">
              <label class="flex cursor-pointer items-start gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-base-200/60 whitespace-nowrap">
                <input
                  type="checkbox"
                  checked={@show_address_primary}
                  phx-click="toggle_address_primary"
                  class="checkbox checkbox-sm mt-0.5"
                />
                <span class="font-medium text-base-content">List by address</span>
              </label>
            </div>
          </div>
        </details>
        </div>
      </div>
      <%= if @can_edit_jobs do %>
        <.link
          patch={~p"/jobs/new"}
          class="btn-icon-neutral"
          title="New Job"
          aria-label="New Job"
        >
          +
        </.link>
      <% end %>
    </div>

    <div class="md:hidden space-y-3">
      <%= for job <- JobsList.prepare_jobs(@jobs, @filter, @sort_by) do %>
        <% mob_expanded? = expanded?(@expanded_job_id, job.id) %>
        <div class={[
          "rounded-lg border overflow-hidden",
          JobsList.mobile_card_classes(job, mob_expanded?)
        ]}>
          <button
            type="button"
            phx-click="toggle_row"
            phx-value-id={job.id}
            class="w-full text-left px-4 py-3"
          >
            <div class="space-y-1">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-base-content break-words">
                    {JobsList.primary_heading(job, @show_address_primary)}
                  </p>
                  <%= if name = JobsList.secondary_heading(job, @show_address_primary) do %>
                    <p class="text-sm text-base-content/70 break-words">{name}</p>
                  <% end %>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-1 self-start">
                  <%= if job.priority == :high do %>
                    <span class={"inline-flex h-5 min-w-[3.25rem] items-center justify-center rounded px-1.5 text-[10px] font-bold uppercase tracking-wide whitespace-nowrap box-border #{JobsList.priority_badge_class(job.priority, @color_code_statuses)}"}>
                      HIGH
                    </span>
                  <% end %>
                  <span class={"inline-flex h-6 w-28 shrink-0 items-center justify-center rounded-md px-2 text-xs font-medium whitespace-nowrap box-border #{JobsList.status_badge_class(job.status, @color_code_statuses)}"}>
                    {JobsList.status_label(job.status)}
                  </span>
                </div>
              </div>
              <%= if not mob_expanded? do %>
                <p class="text-sm text-base-content/80 break-words line-clamp-2">
                  {display(job.work_description)}
                </p>
              <% end %>
            </div>
          </button>

          <%= if mob_expanded? do %>
            <div
              id={"job-expand-sm-#{job.id}"}
              phx-hook="JobExpandEditGuard"
              class="border-t border-base-300 px-4 py-3 text-sm text-base-content space-y-2"
            >
              <.job_expanded_inline_fields
                job={job}
                can_edit_jobs={@can_edit_jobs}
                variant={:mobile}
                edit_keys={@job_expand_editing}
                address_suggestion={@address_suggestion}
              />
              <.job_work_items_section job={job} can_edit_jobs={@can_edit_jobs} edit_keys={@job_expand_editing} />
              <.job_materials_section job={job} can_edit_jobs={@can_edit_jobs} edit_keys={@job_expand_editing} />
              <.job_photos_section
                job={job}
                can_edit_jobs={@can_edit_jobs}
                edit_keys={@job_expand_editing}
                delete_all_step={
                  if @photo_delete_all_pending_job_id == job.id, do: @photo_delete_all_confirm_step, else: 0
                }
              />
              <% te_list = time_entries_for(@expanded_time_entries, job.id) %>
              <% total = TimeTracking.format_total_for_job(job.id, @current_business_id) %>
              <div class="pt-2 border-t border-base-300">
                <div class="flex flex-wrap items-center justify-end gap-2 mb-2">
                  <%= if @can_log_job_time do %>
                    <button
                      type="button"
                      phx-click="open_job_time_log"
                      phx-value-job_id={job.id}
                      class="shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-500"
                    >
                      Add job hours…
                    </button>
                  <% end %>
                </div>
                <p class="text-sm text-base-content/80 mb-1">
                  Total on this job: <span class="font-semibold text-base-content">{total}</span>
                </p>
                <%= if te_list != [] do %>
                  <table class="w-full text-xs mt-1">
                    <thead>
                      <tr class="text-base-content/60">
                        <th class="text-left pr-3 pb-1">Date</th>
                        <th class="text-left pr-3 pb-1">Start</th>
                        <th class="text-left pr-3 pb-1">End</th>
                        <th class="text-left pr-3 pb-1">Duration</th>
                        <%= if @can_log_job_time do %>
                          <th class="text-right pb-1 w-20"><span class="sr-only">Edit or remove</span></th>
                        <% end %>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for te <- te_list do %>
                        <tr class="text-base-content/80">
                          <td class="pr-3 py-0.5">{format_time_entry_date(te.started_at)}</td>
                          <td class="pr-3 py-0.5">{format_time_entry_time(te.started_at)}</td>
                          <td class="pr-3 py-0.5">
                            <%= if te.ended_at do %>
                              {format_time_entry_time(te.ended_at)}
                            <% else %>
                              <span class="text-green-600 font-medium">In progress</span>
                            <% end %>
                          </td>
                          <td class="pr-3 py-0.5">{TimeEntry.format_duration(te) || "—"}</td>
                          <%= if @can_log_job_time do %>
                            <td class="py-0.5 text-right whitespace-nowrap">
                              <div class="inline-flex items-center gap-1 justify-end">
                                <button
                                  type="button"
                                  phx-click="open_edit_job_time_log"
                                  phx-value-job_id={job.id}
                                  phx-value-time_entry_id={te.id}
                                  class="inline-flex rounded p-1 text-base-content/60 hover:bg-base-200 hover:text-blue-600"
                                  title="Edit hours"
                                  aria-label="Edit job hours"
                                >
                                  <.icon name="hero-pencil-square" class="size-4" />
                                </button>
                                <button
                                  type="button"
                                  phx-click="delete_time_entry"
                                  phx-value-job_id={job.id}
                                  phx-value-id={te.id}
                                  data-confirm="Remove these hours from this job?"
                                  class="inline-flex rounded p-1 text-red-600 hover:bg-red-50 hover:text-red-700"
                                  title="Remove hours"
                                  aria-label="Remove job hours"
                                >
                                  <.icon name="hero-x-mark" class="size-4" />
                                </button>
                              </div>
                            </td>
                          <% end %>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                <% end %>
              </div>
              <.job_delete_bar
                job={job}
                delete_step={delete_step_for(@job_delete_steps, job.id)}
                can_edit_jobs={@can_edit_jobs}
              />
            </div>
          <% end %>
        </div>
      <% end %>

      <%= if JobsList.prepare_jobs(@jobs, @filter, @sort_by) == [] do %>
        <div class="bg-base-100 rounded-lg border border-base-300 px-4 py-12 text-center text-base-content/60">
          No jobs found.
        </div>
      <% end %>
    </div>

    <%!-- Job table --%>
    <div class="hidden md:block bg-base-100 rounded-lg border border-base-300 overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-base-300 bg-base-200/40">
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Client</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Address</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Phone</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Work</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Priority</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Status</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Referred By</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Next Action</th>
            <%= if @can_edit_jobs do %>
              <th class="px-4 py-3"></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-base-300">
          <%= for job <- JobsList.prepare_jobs(@jobs, @filter, @sort_by) do %>
            <% job_expanded? = expanded?(@expanded_job_id, job.id) %>
            <tr
              id={"job-row-#{job.id}"}
              phx-click="toggle_row"
              phx-value-id={job.id}
              class={[
                "group cursor-pointer",
                if(job_expanded?, do: "bg-base-200/40", else: "hover:bg-base-200/40")
              ]}
            >
              <td class="px-4 py-3 align-top">
                <div class="font-medium text-base-content whitespace-nowrap">
                  {JobsList.primary_heading(job, @show_address_primary)}
                </div>
                <%= if @show_address_primary do %>
                  <div class="text-sm text-base-content/70">{job.client_name}</div>
                <% end %>
              </td>
              <td class="px-4 py-3 text-base-content/80 max-w-[150px] truncate">
                <%= if @show_address_primary, do: "—", else: RompCrm.Addresses.format_service(job) %>
              </td>
              <td class="px-4 py-3 text-base-content/80 whitespace-nowrap">{job.phone}</td>
              <td class="px-4 py-3 text-base-content/90 max-w-[220px] align-top">
                <%= if job_expanded? do %>
                  <span class="sr-only">Work description shown in expanded row below</span>
                <% else %>
                  <span class="line-clamp-2">{job.work_description}</span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <%= if job.priority == :high do %>
                  <span class={"inline-flex h-6 w-28 shrink-0 items-center justify-center rounded-md px-2 text-xs font-semibold whitespace-nowrap box-border #{JobsList.priority_badge_class(job.priority, @color_code_statuses)}"}>
                    HIGH
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <span class={"inline-flex h-6 w-28 shrink-0 items-center justify-center rounded-md px-2 text-xs font-medium whitespace-nowrap box-border #{JobsList.status_badge_class(job.status, @color_code_statuses)}"}>
                  {JobsList.status_label(job.status)}
                </span>
              </td>
              <td class="px-4 py-3 text-base-content/80">{job.referred_by}</td>
              <td class="px-4 py-3 text-base-content/80 max-w-[150px] truncate">
                {job.next_action}
              </td>
              <%= if @can_edit_jobs do %>
                <td class="px-4 py-3 w-10" onclick="event.stopPropagation()">
                </td>
              <% end %>
            </tr>
            <%= if job_expanded? do %>
              <tr id={"job-expand-md-#{job.id}"} class="bg-base-200/40">
                <td colspan={if(@can_edit_jobs, do: 9, else: 8)} class="px-4 py-3 text-sm text-base-content">
                  <div
                    id={"job-expand-md-panel-#{job.id}"}
                    phx-hook="JobExpandEditGuard"
                    class="grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-2"
                  >
                    <.job_expanded_inline_fields
                      job={job}
                      can_edit_jobs={@can_edit_jobs}
                      variant={:desktop}
                      edit_keys={@job_expand_editing}
                      address_suggestion={@address_suggestion}
                    />
                    <.job_work_items_section
                      job={job}
                      can_edit_jobs={@can_edit_jobs}
                      edit_keys={@job_expand_editing}
                      wrapper_class="lg:col-span-2 pt-1"
                    />
                    <.job_materials_section
                      job={job}
                      can_edit_jobs={@can_edit_jobs}
                      edit_keys={@job_expand_editing}
                      wrapper_class="lg:col-span-2 pt-1"
                    />
                    <.job_photos_section
                      job={job}
                      can_edit_jobs={@can_edit_jobs}
                      edit_keys={@job_expand_editing}
                      delete_all_step={
                        if @photo_delete_all_pending_job_id == job.id,
                          do: @photo_delete_all_confirm_step,
                          else: 0
                      }
                      wrapper_class="lg:col-span-2 pt-1"
                    />
                    <% te_list = time_entries_for(@expanded_time_entries, job.id) %>
                    <div class="lg:col-span-2 pt-2 border-t border-base-300">
                      <div class="flex flex-wrap items-center justify-end gap-2 mb-2">
                        <%= if @can_log_job_time do %>
                          <button
                            type="button"
                            phx-click="open_job_time_log"
                            phx-value-job_id={job.id}
                            class="shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-500"
                          >
                            Add job hours…
                          </button>
                        <% end %>
                      </div>
                      <p class="text-sm text-base-content/80 mb-1">
                        Total on this job:
                        <span class="font-semibold text-base-content">
                          {TimeTracking.format_total_for_job(job.id, @current_business_id)}
                        </span>
                      </p>
                      <%= if te_list != [] do %>
                        <table class="w-full text-xs mt-1">
                          <thead>
                            <tr class="text-base-content/60">
                              <th class="text-left pr-4 pb-1">Date</th>
                              <th class="text-left pr-4 pb-1">Start</th>
                              <th class="text-left pr-4 pb-1">End</th>
                              <th class="text-left pr-4 pb-1">Duration</th>
                              <%= if @can_log_job_time do %>
                                <th class="text-right pb-1 w-20"><span class="sr-only">Edit or remove</span></th>
                              <% end %>
                            </tr>
                          </thead>
                          <tbody>
                            <%= for te <- te_list do %>
                              <tr class="text-base-content/80">
                                <td class="pr-4 py-0.5">
                                  {format_time_entry_date(te.started_at)}
                                </td>
                                <td class="pr-4 py-0.5">
                                  {format_time_entry_time(te.started_at)}
                                </td>
                                <td class="pr-4 py-0.5">
                                  <%= if te.ended_at do %>
                                    {format_time_entry_time(te.ended_at)}
                                  <% else %>
                                    <span class="text-green-600 font-medium">In progress</span>
                                  <% end %>
                                </td>
                                <td class="pr-4 py-0.5">{TimeEntry.format_duration(te) || "—"}</td>
                                <%= if @can_log_job_time do %>
                                  <td class="py-0.5 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1 justify-end">
                                      <button
                                        type="button"
                                        phx-click="open_edit_job_time_log"
                                        phx-value-job_id={job.id}
                                        phx-value-time_entry_id={te.id}
                                        class="inline-flex rounded p-1 text-base-content/60 hover:bg-base-200 hover:text-blue-600"
                                        title="Edit hours"
                                        aria-label="Edit job hours"
                                      >
                                        <.icon name="hero-pencil-square" class="size-4" />
                                      </button>
                                      <button
                                        type="button"
                                        phx-click="delete_time_entry"
                                        phx-value-job_id={job.id}
                                        phx-value-id={te.id}
                                        data-confirm="Remove these hours from this job?"
                                        class="inline-flex rounded p-1 text-red-600 hover:bg-red-50 hover:text-red-700"
                                        title="Remove hours"
                                        aria-label="Remove job hours"
                                      >
                                        <.icon name="hero-x-mark" class="size-4" />
                                      </button>
                                    </div>
                                  </td>
                                <% end %>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      <% end %>
                    </div>
                    <div class="lg:col-span-2">
                      <.job_delete_bar
                        job={job}
                        delete_step={delete_step_for(@job_delete_steps, job.id)}
                        can_edit_jobs={@can_edit_jobs}
                      />
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
          <%= if JobsList.prepare_jobs(@jobs, @filter, @sort_by) == [] do %>
            <tr>
              <td colspan={if(@can_edit_jobs, do: 9, else: 8)} class="px-4 py-12 text-center text-base-content/60">
                No jobs found.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

<%!-- Modal: log hours on a job (closed interval; not punch clock) --%>
<%= if @log_job_time_job_id do %>
  <.modal id="job-time-log-modal" show on_cancel={JS.push("close_job_time_log")}>
    <div class="pr-8">
      <h2 id="job-time-log-modal-title" class="text-lg font-semibold text-base-content">
        <%= if @log_time_entry_id, do: "Edit job hours", else: "Add job hours" %>
      </h2>
      <p class="mt-1 text-sm text-base-content/70">
        For <span class="font-medium text-base-content/90">{@log_job_time_client_name}</span>. Enter when you started and
        finished on <span class="font-medium">this job</span> (pickers use 15-minute steps; you can still type any
        minute). This does <span class="font-medium">not</span> start a live timer.
      </p>
      <%= if @log_time_entry_id && @job_time_ended_at == "" do %>
        <p class="mt-2 rounded-md border border-amber-400/60 bg-amber-500/10 px-2 py-1.5 text-xs text-amber-950 dark:text-amber-100">
          Leave <span class="font-medium">End</span> empty if this visit is still in progress.
        </p>
      <% end %>
      <p class="mt-2 text-xs text-base-content/60">
        Workday punch in/out is separate:
        <a href={~p"/my-timeclock"} class="link link-primary font-medium">Workday timeclock</a>.
      </p>

      <form phx-change="job_time_field" phx-submit="save_job_time_log" class="mt-5 space-y-4">
        <div>
          <label for="job-time-started" class="label mb-1 py-0">
            <span class="label-text text-sm font-medium">Start</span>
          </label>
          <input
            id="job-time-started"
            type="datetime-local"
            name="started_at"
            value={@job_time_started_at}
            step="900"
            class="input input-bordered w-full max-w-md text-sm"
          />
        </div>
        <div>
          <label for="job-time-ended" class="label mb-1 py-0">
            <span class="label-text text-sm font-medium">End</span>
          </label>
          <input
            id="job-time-ended"
            type="datetime-local"
            name="ended_at"
            value={@job_time_ended_at}
            step="900"
            class="input input-bordered w-full max-w-md text-sm"
          />
        </div>
        <div>
          <label for="job-time-notes" class="label mb-1 py-0">
            <span class="label-text text-sm font-medium">Notes (optional)</span>
          </label>
          <textarea
            id="job-time-notes"
            name="notes"
            rows="2"
            class="textarea textarea-bordered w-full max-w-md text-sm"
          ><%= @job_time_notes %></textarea>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <button type="submit" class="btn btn-primary btn-sm">
            <%= if @log_time_entry_id, do: "Update job hours", else: "Save job hours" %>
          </button>
          <button type="button" phx-click="close_job_time_log" class="btn btn-ghost btn-sm">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </.modal>
<% end %>
<%= if @live_action in [:new, :edit] do %>
  <.modal id="job-modal" show on_cancel={JS.patch(~p"/")}>
    <.live_component
      module={RompCrmWeb.JobFormComponent}
      id={@job.id || :new}
      title={if @live_action == :new, do: "New Job", else: "Edit Job"}
      action={@live_action}
      job={@job}
      current_business_id={@current_business_id}
      actor_user_id={@current_scope.user.id}
      can_edit_jobs={@can_edit_jobs}
      clients_for_picker={@clients_for_picker}
      patch={~p"/"}
    />
  </.modal>
<% end %>
<%= if @add_photos_job_id do %>
  <.job_add_photos_modal
    job_id={@add_photos_job_id}
    client_name={@add_photos_client_name}
    saved_count={@add_photos_saved_count}
    upload_url={~p"/jobs/#{@add_photos_job_id}/photos"}
  />
<% end %>
<%= if @photo_viewer_job_id && @photo_viewer_photo_id do %>
  <% viewer_job = photo_viewer_job_for_assigns(@jobs, @photo_viewer_job_id) %>
  <%= if viewer_job && viewer_job.photos != [] do %>
    <.job_photo_viewer_modal
      job_id={viewer_job.id}
      photo_id={@photo_viewer_photo_id}
      photos={viewer_job.photos}
      position={photo_viewer_position(viewer_job.photos, @photo_viewer_photo_id)}
      total={length(viewer_job.photos)}
    />
  <% end %>
<% end %>
<%= if @pending_client_update do %>
  <.modal id="client-update-confirm-modal" show on_cancel={JS.push("cancel_client_update")}>
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-base-content">Update client contact?</h2>
      <p class="text-sm text-base-content/80">
        This will update contact details for
        <span class="font-medium">{@pending_client_update.client_name || "this client"}</span>
        and all {@pending_client_update.job_count} linked job(s).
      </p>
      <div class="flex flex-wrap gap-2 pt-2">
        <button type="button" phx-click="confirm_client_update" class="btn btn-primary btn-sm">
          Update client and jobs
        </button>
        <button type="button" phx-click="cancel_client_update" class="btn btn-ghost btn-sm">
          Cancel
        </button>
      </div>
    </div>
  </.modal>
<% end %>
<%= if @client_match do %>
  <.modal id="client-match-modal" show on_cancel={JS.push("cancel_client_match")}>
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-base-content">Link to existing client?</h2>
      <p class="text-sm text-base-content/80">
        This contact may match an existing client. Pick one to link, or create a new client record.
      </p>
      <ul class="space-y-2">
        <%= for candidate <- @client_match.candidates do %>
          <li>
            <button
              type="button"
              phx-click="pick_client_match"
              phx-value-client_id={candidate.id}
              class="btn btn-outline btn-sm w-full justify-start text-left"
            >
              <span class="font-medium">{candidate.client_name}</span>
              <%= if candidate.reason != "" do %>
                <span class="text-base-content/60 ml-2">— {candidate.reason}</span>
              <% end %>
            </button>
          </li>
        <% end %>
      </ul>
      <div class="flex flex-wrap gap-2 pt-2 border-t border-base-300">
        <button type="button" phx-click="confirm_new_client_for_job" class="btn btn-primary btn-sm">
          Create new client
        </button>
        <button type="button" phx-click="cancel_client_match" class="btn btn-ghost btn-sm">
          Cancel
        </button>
      </div>
    </div>
  </.modal>
<% end %>
</Layouts.app>
