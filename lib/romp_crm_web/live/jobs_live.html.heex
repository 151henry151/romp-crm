<div class="min-h-screen bg-base-200/40 text-base-content">
  <%!-- Header --%>
  <header class="bg-base-100 border-b border-base-300 px-4 sm:px-6 py-4">
    <div class="max-w-screen-xl mx-auto flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <div class="brand-logo-hitbox inline-flex">
          <span class="brand-logo-crop block aspect-[1154/489] h-12 sm:h-14 overflow-hidden rounded-2xl">
            <img
              src={~p"/images/romp-crm-logo-main.png"}
              alt="Romp CRM"
              class="brand-logo-light block h-full w-full object-cover object-center max-w-none"
            />
            <img
              src={~p"/images/romp-crm-logo-main-dark.png"}
              alt="Romp CRM"
              class="brand-logo-dark block h-full w-full object-cover object-center max-w-none"
            />
          </span>
        </div>
        <p class="text-sm text-base-content/70 mt-1">Customer & Job Tracker</p>
        <p class="text-xs text-base-content/70 mt-1">
          <span class="text-base-content/80 font-medium">Text new jobs and updates:</span>
          <a
            href={@sms_intake_href}
            class="text-blue-600 hover:text-blue-800 font-semibold whitespace-nowrap"
          >
            {@sms_intake_display}
          </a>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <%= if assigns[:my_businesses] && length(@my_businesses) > 1 do %>
          <form action={~p"/business/switch"} method="post" class="flex items-center gap-2">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <label for="business-switch" class="text-xs text-base-content/80 whitespace-nowrap">
              Business
            </label>
            <select
              id="business-switch"
              name="business_id"
              class="text-sm border border-base-300 rounded-md px-2 py-1 bg-base-100 max-w-[14rem]"
              onchange="this.form.requestSubmit()"
            >
              <%= for b <- @my_businesses do %>
                <option value={b.id} selected={b.id == @current_business_id}>{b.name}</option>
              <% end %>
            </select>
          </form>
        <% end %>
        <.link
          navigate={~p"/time-log"}
          class="text-sm font-medium text-blue-600 hover:text-blue-800"
        >
          Job time log
        </.link>
        <.link
          navigate={~p"/my-timeclock"}
          class="text-sm font-medium text-blue-600 hover:text-blue-800"
        >
          Workday timeclock
        </.link>
        <%= if @is_business_owner do %>
          <.link
            navigate={~p"/employees"}
            class="text-sm font-medium text-blue-600 hover:text-blue-800"
          >
            Employees
          </.link>
        <% end %>
        <.link
          navigate={~p"/businesses"}
          class="text-sm font-medium text-blue-600 hover:text-blue-800"
        >
          Businesses
        </.link>
        <.link
          href={~p"/users/settings"}
          class="text-sm font-medium text-blue-600 hover:text-blue-800"
        >
          Settings
        </.link>
        <Layouts.support_contact />
        <Layouts.theme_toggle />
      </div>
    </div>
  </header>

  <main class="max-w-screen-xl mx-auto px-4 sm:px-6 py-6">
    <%!-- Status filter tabs + new job --%>
    <div class="mb-6 flex flex-wrap items-center gap-2 border-b border-base-300">
      <div class="flex min-w-0 flex-1 flex-wrap gap-1">
        <%= for {label, status} <- [{"All", :all} | Enum.map([:lead, :pending, :in_progress, :done], &{status_label(&1), &1})] do %>
          <button
            phx-click="filter"
            phx-value-status={status}
            class={[
              "px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium border-b-2 -mb-px transition-colors",
              if(@filter == status,
                do: "border-blue-600 text-blue-600",
                else: "border-transparent text-base-content/70 hover:text-base-content"
              )
            ]}
          >
            {label}
            <span class={[
              "ml-1.5 rounded-full px-1.5 py-0.5 text-xs",
              if(@filter == status,
                do: "bg-blue-100 text-blue-700",
                else: "bg-base-200 text-base-content/70"
              )
            ]}>
              {count_for(@jobs, status)}
            </span>
          </button>
        <% end %>
      </div>
      <%= if @can_edit_jobs do %>
        <.link
          patch={~p"/jobs/new"}
          class="inline-flex h-10 min-w-[4.5rem] shrink-0 items-center justify-center self-center rounded-lg bg-blue-600 px-6 text-lg font-semibold leading-none text-white no-underline shadow-sm hover:bg-blue-500 hover:no-underline"
          title="New Job"
          aria-label="New Job"
        >
          +
        </.link>
      <% end %>
    </div>

    <div class="md:hidden space-y-3">
      <%= for job <- visible_jobs(@jobs, @filter) do %>
        <div class="bg-base-100 rounded-lg border border-base-300 overflow-hidden">
          <button
            type="button"
            phx-click="toggle_row"
            phx-value-id={job.id}
            class="w-full text-left px-4 py-3"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 space-y-1">
                <p class="font-semibold text-base-content break-words">{job.client_name}</p>
                <%= if not expanded?(@expanded_job_id, job.id) do %>
                  <p class="text-sm text-base-content/80 break-words line-clamp-2">
                    <span class="font-medium text-base-content/90">Work:</span>
                    {display(job.work_description)}
                  </p>
                <% end %>
                <%= if is_binary(job.notes) && String.trim(job.notes) != "" do %>
                  <p class="text-sm text-base-content/80 break-words">
                    <span class="font-medium text-base-content/90">Notes:</span>
                    {job.notes}
                  </p>
                <% end %>
              </div>
              <span class={"inline-flex h-6 w-24 items-center justify-center rounded-md px-2 text-xs font-medium whitespace-nowrap #{status_class(job.status)}"}>
                {status_label(job.status)}
              </span>
            </div>
          </button>

          <%= if expanded?(@expanded_job_id, job.id) do %>
            <div
              id={"job-expand-sm-#{job.id}"}
              class="border-t border-base-300 px-4 py-3 text-sm text-base-content space-y-2"
            >
              <p>
                <span class="font-medium text-base-content/90">Address:</span>
                <span class="break-words text-base-content">{display(job.address)}</span>
              </p>
              <p>
                <span class="font-medium text-base-content/90">Phone:</span>
                <span class="text-base-content">{display(job.phone)}</span>
              </p>
              <p>
                <span class="font-medium text-base-content/90">Work:</span>
                <span class="block mt-0.5 break-words text-base-content">
                  {display(job.work_description)}
                </span>
              </p>
              <p>
                <span class="font-medium text-base-content/90">Priority:</span>
                <span class="text-base-content">
                  <%= if job.priority == :high do %>
                    High
                  <% else %>
                    Normal
                  <% end %>
                </span>
              </p>
              <p>
                <span class="font-medium text-base-content/90">Status:</span>
                <span class="text-base-content">{status_label(job.status)}</span>
              </p>
              <p>
                <span class="font-medium text-base-content/90">Referred By:</span>
                <span class="break-words text-base-content">{display(job.referred_by)}</span>
              </p>
              <p>
                <span class="font-medium text-base-content/90">Next Action:</span>
                <span class="break-words text-base-content">{display(job.next_action)}</span>
              </p>
              <%!-- Hours on this job (client / site) — not the employer punch clock --%>
              <% te_list = time_entries_for(@expanded_time_entries, job.id) %>
              <% total = TimeTracking.format_total_for_job(job.id, @current_business_id) %>
              <div class="pt-2 border-t border-base-300">
                <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                  <div>
                    <p class="font-medium text-base-content/90">Hours on this job</p>
                    <p class="text-xs text-base-content/60 mt-0.5">
                      Client/site time — not your workday punch clock (
                      <.link navigate={~p"/my-timeclock"} class="text-blue-600 hover:text-blue-800">
                        open timeclock
                      </.link>
                      ).
                    </p>
                  </div>
                  <%= if @can_log_job_time do %>
                    <button
                      type="button"
                      phx-click="open_job_time_log"
                      phx-value-job_id={job.id}
                      class="shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-500"
                    >
                      Add job hours…
                    </button>
                  <% end %>
                </div>
                <p class="text-sm text-base-content/80 mb-1">
                  Total on this job: <span class="font-semibold text-base-content">{total}</span>
                  <.link
                    navigate={~p"/time-log"}
                    class="ml-2 text-xs text-blue-600 hover:text-blue-800"
                  >
                    View all job hours →
                  </.link>
                </p>
                <%= if te_list != [] do %>
                  <table class="w-full text-xs mt-1">
                    <thead>
                      <tr class="text-base-content/60">
                        <th class="text-left pr-3 pb-1">Date</th>
                        <th class="text-left pr-3 pb-1">Start</th>
                        <th class="text-left pr-3 pb-1">End</th>
                        <th class="text-left pb-1">Duration</th>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for te <- te_list do %>
                        <tr class="text-base-content/80">
                          <td class="pr-3 py-0.5">{format_time_entry_date(te.started_at)}</td>
                          <td class="pr-3 py-0.5">{format_time_entry_time(te.started_at)}</td>
                          <td class="pr-3 py-0.5">
                            <%= if te.ended_at do %>
                              {format_time_entry_time(te.ended_at)}
                            <% else %>
                              <span class="text-green-600 font-medium">In progress</span>
                            <% end %>
                          </td>
                          <td class="py-0.5">{TimeEntry.format_duration(te) || "—"}</td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                <% end %>
              </div>
              <%= if @can_edit_jobs do %>
                <div class="pt-2 flex items-center gap-4">
                  <.link
                    patch={~p"/jobs/#{job.id}/edit"}
                    class="text-blue-600 hover:text-blue-800 font-medium"
                  >
                    Edit
                  </.link>
                  <button
                    phx-click="delete"
                    phx-value-id={job.id}
                    data-confirm="Delete this job?"
                    class="text-red-500 hover:text-red-700 font-medium"
                  >
                    Delete
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= if visible_jobs(@jobs, @filter) == [] do %>
        <div class="bg-base-100 rounded-lg border border-base-300 px-4 py-12 text-center text-base-content/60">
          No jobs found.
        </div>
      <% end %>
    </div>

    <%!-- Job table --%>
    <div class="hidden md:block bg-base-100 rounded-lg border border-base-300 overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-base-300 bg-base-200/40">
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Client</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Address</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Phone</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Work</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Priority</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Status</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Referred By</th>
            <th class="text-left px-4 py-3 font-medium text-base-content/80">Next Action</th>
            <%= if @can_edit_jobs do %>
              <th class="px-4 py-3"></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-base-300">
          <%= for job <- visible_jobs(@jobs, @filter) do %>
            <tr
              id={"job-row-#{job.id}"}
              phx-click="toggle_row"
              phx-value-id={job.id}
              class="hover:bg-base-200/40 group cursor-pointer"
            >
              <td class="px-4 py-3 font-medium text-base-content whitespace-nowrap">
                {job.client_name}
              </td>
              <td class="px-4 py-3 text-base-content/80 max-w-[150px] truncate">{job.address}</td>
              <td class="px-4 py-3 text-base-content/80 whitespace-nowrap">{job.phone}</td>
              <td class="px-4 py-3 text-base-content/90 max-w-[220px] align-top">
                <%= if expanded?(@expanded_job_id, job.id) do %>
                  <span class="sr-only">Work description shown in expanded row below</span>
                <% else %>
                  <span class="line-clamp-2">{job.work_description}</span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <%= if job.priority == :high do %>
                  <span class={"inline-flex h-6 w-24 items-center justify-center rounded-md px-2 text-xs font-semibold whitespace-nowrap #{priority_class(job.priority)}"}>
                    HIGH
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <span class={"inline-flex h-6 w-24 items-center justify-center rounded-md px-2 text-xs font-medium whitespace-nowrap #{status_class(job.status)}"}>
                  {status_label(job.status)}
                </span>
              </td>
              <td class="px-4 py-3 text-base-content/80">{job.referred_by}</td>
              <td class="px-4 py-3 text-base-content/80 max-w-[150px] truncate">
                {job.next_action}
              </td>
              <%= if @can_edit_jobs do %>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <.link
                      patch={~p"/jobs/#{job.id}/edit"}
                      class="text-blue-600 hover:text-blue-800 font-medium"
                    >
                      Edit
                    </.link>
                    <button
                      phx-click="delete"
                      phx-value-id={job.id}
                      data-confirm="Delete this job?"
                      class="text-red-500 hover:text-red-700 font-medium"
                    >
                      Delete
                    </button>
                  </div>
                </td>
              <% end %>
            </tr>
            <%= if expanded?(@expanded_job_id, job.id) do %>
              <tr id={"job-expand-md-#{job.id}"} class="bg-base-200/40">
                <td colspan={if(@can_edit_jobs, do: 9, else: 8)} class="px-4 py-3 text-sm text-base-content">
                  <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-2">
                    <p>
                      <span class="font-medium text-base-content/90">Client:</span> {display(
                        job.client_name
                      )}
                    </p>
                    <p>
                      <span class="font-medium text-base-content/90">Address:</span> {display(
                        job.address
                      )}
                    </p>
                    <p>
                      <span class="font-medium text-base-content/90">Phone:</span> {display(
                        job.phone
                      )}
                    </p>
                    <p>
                      <span class="font-medium text-base-content/90">Priority:</span> {if job.priority ==
                                                                                            :high,
                                                                                          do:
                                                                                            "High",
                                                                                          else:
                                                                                            "Normal"}
                    </p>
                    <p>
                      <span class="font-medium text-base-content/90">Status:</span> {status_label(
                        job.status
                      )}
                    </p>
                    <p>
                      <span class="font-medium text-base-content/90">Referred By:</span> {display(
                        job.referred_by
                      )}
                    </p>
                    <p>
                      <span class="font-medium text-base-content/90">Next Action:</span> {display(
                        job.next_action
                      )}
                    </p>
                    <p class="lg:col-span-2">
                      <span class="font-medium text-base-content/90">Work:</span>
                      <span class="mt-1 block whitespace-pre-wrap break-words text-base-content">
                        {display(job.work_description)}
                      </span>
                    </p>
                    <p class="lg:col-span-2">
                      <span class="font-medium text-base-content/90">Notes:</span> {display(
                        job.notes
                      )}
                    </p>
                    <%!-- Hours on this job --%>
                    <% te_list = time_entries_for(@expanded_time_entries, job.id) %>
                    <div class="lg:col-span-2 pt-2 border-t border-base-300">
                      <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                        <div>
                          <p class="font-medium text-base-content/90">Hours on this job</p>
                          <p class="text-xs text-base-content/60 mt-0.5 max-w-xl">
                            Log time for <span class="font-medium text-base-content/80">this client ticket</span>.
                            For “on the clock for the company,” use
                            <.link navigate={~p"/my-timeclock"} class="text-blue-600 hover:text-blue-800 font-medium">
                              Workday timeclock
                            </.link>
                            .
                          </p>
                        </div>
                        <%= if @can_log_job_time do %>
                          <button
                            type="button"
                            phx-click="open_job_time_log"
                            phx-value-job_id={job.id}
                            class="shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-500"
                          >
                            Add job hours…
                          </button>
                        <% end %>
                      </div>
                      <p class="text-sm text-base-content/80 mb-1">
                        Total on this job:
                        <span class="font-semibold text-base-content">
                          {TimeTracking.format_total_for_job(job.id, @current_business_id)}
                        </span>
                        <.link
                          navigate={~p"/time-log"}
                          class="ml-2 text-xs text-blue-600 hover:text-blue-800"
                        >
                          View all job hours →
                        </.link>
                      </p>
                      <%= if te_list != [] do %>
                        <table class="w-full text-xs mt-1">
                          <thead>
                            <tr class="text-base-content/60">
                              <th class="text-left pr-4 pb-1">Date</th>
                              <th class="text-left pr-4 pb-1">Start</th>
                              <th class="text-left pr-4 pb-1">End</th>
                              <th class="text-left pb-1">Duration</th>
                            </tr>
                          </thead>
                          <tbody>
                            <%= for te <- te_list do %>
                              <tr class="text-base-content/80">
                                <td class="pr-4 py-0.5">
                                  {format_time_entry_date(te.started_at)}
                                </td>
                                <td class="pr-4 py-0.5">
                                  {format_time_entry_time(te.started_at)}
                                </td>
                                <td class="pr-4 py-0.5">
                                  <%= if te.ended_at do %>
                                    {format_time_entry_time(te.ended_at)}
                                  <% else %>
                                    <span class="text-green-600 font-medium">In progress</span>
                                  <% end %>
                                </td>
                                <td class="py-0.5">{TimeEntry.format_duration(te) || "—"}</td>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      <% end %>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
          <%= if visible_jobs(@jobs, @filter) == [] do %>
            <tr>
              <td colspan={if(@can_edit_jobs, do: 9, else: 8)} class="px-4 py-12 text-center text-base-content/60">
                No jobs found.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </main>

  <Layouts.legal_footer />
</div>

<%!-- Modal: log hours on a job (closed interval; not punch clock) --%>
<%= if @log_job_time_job_id do %>
  <.modal id="job-time-log-modal" show on_cancel={JS.push("close_job_time_log")}>
    <div class="pr-8">
      <h2 id="job-time-log-modal-title" class="text-lg font-semibold text-gray-900">
        Add job hours
      </h2>
      <p class="mt-1 text-sm text-gray-600">
        For <span class="font-medium text-gray-800">{@log_job_time_client_name}</span>. Enter when you started and
        finished on <span class="font-medium">this job</span> (pickers use 15-minute steps; you can still type any
        minute). This does <span class="font-medium">not</span> start a live timer.
      </p>
      <p class="mt-2 text-xs text-gray-500">
        Workday punch in/out is separate:
        <a href={~p"/my-timeclock"} class="text-blue-600 hover:underline font-medium">Workday timeclock</a>.
      </p>

      <form phx-change="job_time_field" phx-submit="save_job_time_log" class="mt-5 space-y-4">
        <div>
          <label for="job-time-started" class="block text-sm font-medium text-gray-700 mb-1">Start</label>
          <input
            id="job-time-started"
            type="datetime-local"
            name="started_at"
            value={@job_time_started_at}
            step="900"
            class="w-full max-w-md rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500"
          />
        </div>
        <div>
          <label for="job-time-ended" class="block text-sm font-medium text-gray-700 mb-1">End</label>
          <input
            id="job-time-ended"
            type="datetime-local"
            name="ended_at"
            value={@job_time_ended_at}
            step="900"
            class="w-full max-w-md rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500"
          />
        </div>
        <div>
          <label for="job-time-notes" class="block text-sm font-medium text-gray-700 mb-1">Notes (optional)</label>
          <textarea
            id="job-time-notes"
            name="notes"
            rows="2"
            class="w-full max-w-md rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500"
          ><%= @job_time_notes %></textarea>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500">
            Save job hours
          </button>
          <button type="button" phx-click="close_job_time_log" class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </.modal>
<% end %>
<%= if @live_action in [:new, :edit] do %>
  <.modal id="job-modal" show on_cancel={JS.patch(~p"/")}>
    <.live_component
      module={RompCrmWeb.JobFormComponent}
      id={@job.id || :new}
      title={if @live_action == :new, do: "New Job", else: "Edit Job"}
      action={@live_action}
      job={@job}
      current_business_id={@current_business_id}
      actor_user_id={@current_scope.user.id}
      can_edit_jobs={@can_edit_jobs}
      patch={~p"/"}
    />
  </.modal>
<% end %>
