<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  socket={@socket}
  show_sms_assistant_intro_modal={@show_sms_assistant_intro_modal}
  show_workspace_nav={true}
  current_business_id={@current_business_id}
  my_businesses={@my_businesses}
  is_business_owner={@is_business_owner}
  content_width={:wide}
>
  <div class="mx-auto flex h-[min(78vh,42rem)] max-w-5xl flex-col">
    <.header>
      Chats
      <:subtitle>
        Message your RompCRM agent or view scheduling conversations with customers.
      </:subtitle>
    </.header>

    <%= if is_nil(@current_business_id) do %>
      <p class="mt-4 text-sm text-base-content/70">Pick a workspace to view chats.</p>
    <% else %>
      <div class="mt-3 flex min-h-0 flex-1 gap-3">
        <nav class="flex w-44 shrink-0 flex-col gap-1 overflow-y-auto rounded-xl border border-base-300 bg-base-100/80 p-2 shadow-sm sm:w-52">
          <%= for thread <- @thread_list do %>
            <.link
              patch={
                if thread.kind == :agent,
                  do: ~p"/chats",
                  else: ~p"/chats?phone=#{thread.phone_normalized}"
              }
              class={[
                "block rounded-lg px-2.5 py-2 text-left transition-colors",
                active_thread?(thread, @thread_kind, @client_phone) &&
                  "bg-primary/15 ring-1 ring-primary/30",
                !active_thread?(thread, @thread_kind, @client_phone) &&
                  "hover:bg-base-200/80"
              ]}
            >
              <div class="text-sm font-medium text-base-content leading-tight">{thread.label}</div>
              <div class="mt-0.5 text-[11px] text-base-content/55 leading-snug">{thread.subtitle}</div>
            </.link>
          <% end %>
        </nav>

        <div class="flex min-w-0 flex-1 flex-col rounded-xl border border-base-300 bg-base-100/80 p-3 shadow-sm">
          <%= if @thread_kind == :client do %>
            <div class="mb-2 flex flex-wrap items-center justify-between gap-2 border-b border-base-300 pb-2">
              <div>
                <h2 class="text-sm font-semibold text-base-content">{@client_name || "Customer"}</h2>
                <p class="text-xs text-base-content/60">Scheduling agent SMS thread</p>
              </div>
              <div class="flex flex-wrap gap-2">
                <%= if @client_taken_over? do %>
                  <button
                    type="button"
                    phx-click="hand_off"
                    data-confirm="Hand this chat back to the scheduling agent? The customer will be texted that automated scheduling has resumed."
                    class="btn btn-outline btn-xs"
                  >
                    Hand off to agent
                  </button>
                <% else %>
                  <button type="button" phx-click="open_takeover_confirm" class="btn btn-primary btn-xs">
                    Take over chat
                  </button>
                <% end %>
              </div>
            </div>

            <%= if @client_taken_over? do %>
              <p class="mb-2 rounded-lg border border-info/30 bg-info/10 px-3 py-2 text-xs text-base-content/80">
                You are replying live by SMS. The scheduling agent is paused for this customer.
              </p>
            <% else %>
              <p class="mb-2 rounded-lg border border-base-300 bg-base-200/40 px-3 py-2 text-xs text-base-content/70">
                The scheduling assistant is handling this thread. Take over to reply as a live person.
              </p>
            <% end %>
          <% else %>
            <h2 class="mb-2 border-b border-base-300 pb-2 text-sm font-semibold text-base-content">
              RompCRM agent
            </h2>
          <% end %>

          <div
            id="chats-panel"
            phx-hook="AgentChatScroll"
            class="min-h-0 flex-1 overflow-y-auto rounded-lg border border-base-300/60 bg-base-200/20 p-2"
          >
            <%= if @chat_rows == [] and not @chat_agent_typing? do %>
              <p class="text-sm text-base-content/60">
                <%= if @thread_kind == :agent do %>
                  No messages yet. Text your agent here or send an SMS from your profile phone.
                <% else %>
                  No messages in this thread yet.
                <% end %>
              </p>
            <% else %>
              <.chat_thread rows={@chat_rows} id="chats-thread" />
              <%= if @chat_agent_typing? do %>
                <.chat_typing_indicator id="chats-typing" label="RompCRM agent" />
              <% end %>
            <% end %>
          </div>

          <.chat_compose
            form_id="chats-compose"
            placeholder={compose_placeholder(@thread_kind, @client_taken_over?)}
            disabled={compose_disabled?(@thread_kind, @client_taken_over?, @chat_sending?)}
          />
        </div>
      </div>
    <% end %>
  </div>

  <%= if @show_takeover_confirm? do %>
    <div class="modal modal-open" role="dialog" aria-labelledby="takeover-modal-title">
      <div class="modal-box max-w-md">
        <h3 id="takeover-modal-title" class="text-lg font-semibold">Take over this chat?</h3>
        <p class="mt-2 text-sm text-base-content/80">
          The customer will receive a text:
          <span class="italic">"We're connecting you with a team member now — please hold on a moment."</span>
          The scheduling agent will stop replying until you hand the chat back.
        </p>
        <div class="modal-action">
          <button type="button" phx-click="cancel_takeover_confirm" class="btn btn-ghost btn-sm">
            Cancel
          </button>
          <button type="button" phx-click="confirm_takeover" class="btn btn-primary btn-sm">
            Take over chat
          </button>
        </div>
      </div>
      <button type="button" class="modal-backdrop" phx-click="cancel_takeover_confirm" aria-label="Close" />
    </div>
  <% end %>
</Layouts.app>
