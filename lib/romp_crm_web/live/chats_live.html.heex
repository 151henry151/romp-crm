<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  socket={@socket}
  show_sms_assistant_intro_modal={@show_sms_assistant_intro_modal}
  show_workspace_nav={true}
  current_business_id={@current_business_id}
  my_businesses={@my_businesses}
  is_business_owner={@is_business_owner}
  content_width={:wide}
  viewport_fill={not is_nil(@current_business_id)}
  viewport_fill_compact={@mobile_view == :thread}
>
  <div class={["chats-page", @mobile_view == :thread && "chats-page--thread"]}>
    <div class={[@mobile_view == :thread && "max-md:hidden", "chats-thread-static"]}>
      <.header>
        Chats
        <:subtitle>
          Message your RompCRM agent or view scheduling conversations with customers.
        </:subtitle>
      </.header>
    </div>

    <%= if is_nil(@current_business_id) do %>
      <p class="mt-4 text-sm text-base-content/70">Pick a workspace to view chats.</p>
    <% else %>
      <div
        class={[
          "chats-workspace min-h-0 flex-1",
          @mobile_view == :list && "mt-3 md:mt-3",
          @mobile_view == :thread && "max-md:mt-0"
        ]}
      >
        <nav
          class={[
            "chats-sidebar",
            @mobile_view == :thread && "max-md:hidden",
            @mobile_view == :list && "max-md:flex-1 max-md:w-full"
          ]}
        >
          <p class="px-2 pb-1 text-xs font-medium uppercase tracking-wide text-base-content/50 md:hidden">
            Conversations
          </p>
          <%= for thread <- @thread_list do %>
            <.link
              patch={thread_patch(thread)}
              class={[
                "block rounded-lg px-3 py-3 text-left transition-colors md:px-2.5 md:py-2",
                active_thread?(thread, @thread_kind, @client_phone) &&
                  "bg-primary/15 ring-1 ring-primary/30",
                !active_thread?(thread, @thread_kind, @client_phone) &&
                  "hover:bg-base-200/80"
              ]}
            >
              <div class="text-sm font-medium text-base-content leading-tight">{thread.label}</div>
              <div class="mt-0.5 text-[11px] text-base-content/55 leading-snug">{thread.subtitle}</div>
            </.link>
          <% end %>
        </nav>

        <div class={["chats-thread-card", @mobile_view == :list && "max-md:hidden"]}>
          <%= if @thread_kind == :client do %>
            <div class="chats-thread-static flex flex-wrap items-center gap-2 border-b border-base-300 pb-2">
              <.link
                patch={~p"/chats"}
                class="btn btn-ghost btn-xs gap-0.5 px-2 md:hidden"
                aria-label="Back to conversation list"
              >
                <.icon name="hero-chevron-left" class="size-4" />
                Chats
              </.link>
              <div class="min-w-0 flex-1">
                <h2 class="text-sm font-semibold text-base-content">{@client_name || "Customer"}</h2>
                <p class="text-xs text-base-content/60">Scheduling agent SMS thread</p>
              </div>
              <div class="flex w-full flex-wrap gap-2 sm:w-auto sm:justify-end">
                <%= if @client_taken_over? do %>
                  <button
                    type="button"
                    phx-click="hand_off"
                    data-confirm="Hand this chat back to the scheduling agent? The customer will be texted that automated scheduling has resumed."
                    class="btn btn-outline btn-xs"
                  >
                    Hand off to agent
                  </button>
                <% else %>
                  <button type="button" phx-click="open_takeover_confirm" class="btn btn-primary btn-xs">
                    Take over chat
                  </button>
                <% end %>
              </div>
            </div>

            <%= if @client_taken_over? do %>
              <p class="chats-thread-static rounded-lg border border-info/30 bg-info/10 px-3 py-2 text-xs text-base-content/80">
                You are replying live by SMS. The scheduling agent is paused for this customer.
              </p>
            <% else %>
              <p class="chats-thread-static rounded-lg border border-base-300 bg-base-200/40 px-3 py-2 text-xs text-base-content/70">
                The scheduling assistant is handling this thread. Take over to reply as a live person.
              </p>
            <% end %>
          <% else %>
            <div class="chats-thread-static flex items-center gap-2 border-b border-base-300 pb-2">
              <.link
                patch={~p"/chats"}
                class="btn btn-ghost btn-xs gap-0.5 px-2 md:hidden"
                aria-label="Back to conversation list"
              >
                <.icon name="hero-chevron-left" class="size-4" />
                Chats
              </.link>
              <h2 class="text-sm font-semibold text-base-content">RompCRM agent</h2>
            </div>
          <% end %>

          <div id="chats-panel" phx-hook="AgentChatScroll" class="chats-message-panel">
            <%= if @chat_rows == [] and not @chat_agent_typing? do %>
              <p class="text-sm text-base-content/60">
                <%= if @thread_kind == :agent do %>
                  No messages yet. Text your agent here or send an SMS from your profile phone.
                <% else %>
                  No messages in this thread yet.
                <% end %>
              </p>
            <% else %>
              <.chat_thread rows={@chat_rows} id="chats-thread" />
              <%= if @chat_agent_typing? do %>
                <.chat_typing_indicator id="chats-typing" label="RompCRM agent" />
              <% end %>
            <% end %>
          </div>

          <div class="chats-thread-static pt-1">
            <.chat_compose
              form_id="chats-compose"
              placeholder={compose_placeholder(@thread_kind, @client_taken_over?)}
              disabled={compose_disabled?(@thread_kind, @client_taken_over?, @chat_sending?)}
            />
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%= if @show_takeover_confirm? do %>
    <.modal id="takeover-confirm-modal" show on_cancel={JS.push("cancel_takeover_confirm")}>
      <div class="max-w-md space-y-4 pr-8">
        <h2 id="takeover-modal-title" class="text-lg font-semibold text-base-content">
          Take over this chat?
        </h2>
        <p class="text-sm text-base-content/80">
          The customer will receive a text:
          <span class="italic">"We're connecting you with a team member now — please hold on a moment."</span>
          The scheduling agent will stop replying until you hand the chat back.
        </p>
        <div class="flex flex-wrap gap-2 pt-2">
          <button type="button" phx-click="confirm_takeover" class="btn btn-primary btn-sm">
            Take over chat
          </button>
          <button type="button" phx-click="cancel_takeover_confirm" class="btn btn-ghost btn-sm">
            Cancel
          </button>
        </div>
      </div>
    </.modal>
  <% end %>
</Layouts.app>
