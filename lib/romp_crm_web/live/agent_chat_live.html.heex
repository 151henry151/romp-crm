<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  socket={@socket}
  show_sms_assistant_intro_modal={@show_sms_assistant_intro_modal}
  show_workspace_nav={true}
  current_business_id={@current_business_id}
  my_businesses={@my_businesses}
  is_business_owner={@is_business_owner}
  content_width={:wide}
>
  <div class="mx-auto flex h-[min(78vh,42rem)] w-full max-w-3xl flex-col">
    <.header>
      Chat
      <:subtitle>
        Message the RompCRM agent here or by SMS — one shared history for your workspace.
      </:subtitle>
    </.header>

    <%= if is_nil(@current_business_id) do %>
      <p class="mt-4 text-sm text-base-content/70">Pick a workspace to view the agent chat.</p>
    <% else %>
      <div
        id="agent-chat-panel"
        phx-hook="AgentChatScroll"
        class="mt-3 min-h-0 flex-1 overflow-y-auto rounded-xl border border-base-300 bg-base-100/80 p-3 shadow-sm"
      >
        <%= if @chat_rows == [] do %>
          <p class="text-sm text-base-content/60">
            No messages yet. Text your agent from here or send an SMS from your profile phone.
          </p>
        <% else %>
          <.chat_thread rows={@chat_rows} id="agent-chat-thread" />
        <% end %>
      </div>

      <.chat_compose disabled={@chat_sending?} form_id="agent-chat-compose" />
    <% end %>
  </div>
</Layouts.app>
