<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  socket={@socket}
  show_sms_assistant_intro_modal={@show_sms_assistant_intro_modal}
  show_workspace_nav={true}
  current_business_id={@current_business_id}
  my_businesses={@my_businesses}
  is_business_owner={@is_business_owner}
  content_width={:wide}
>
  <div class="space-y-8 text-base-content">
    <.header>
      Businesses
      <:subtitle>
        <%= if @may_create_business do %>
          Create a business, invite team members by email, and switch between them from the job list.
        <% else %>
          Workspaces you belong to. Team invitations cover your access — you can’t create a new organization here.
        <% end %>
      </:subtitle>
    </.header>

    <div class={[
      "grid gap-8",
      @may_create_business && "xl:grid-cols-[min(22rem,100%)_1fr] xl:items-start"
    ]}>
      <%= if @may_create_business do %>
        <div class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm xl:sticky xl:top-6">
        <h2 class="text-sm font-semibold text-base-content">Create a business</h2>
        <.form
          for={@form}
          id="new-business"
          phx-change="validate_business"
          phx-submit="create_business"
          class="mt-3 space-y-3"
        >
          <.input field={@form[:name]} type="text" label="Business name" required />
          <.button class="btn btn-primary w-full" type="submit">Create</.button>
        </.form>
        </div>
      <% end %>

      <div class="space-y-4 min-w-0">
        <h2 class="text-sm font-semibold text-base-content">Your businesses</h2>
      <%= if @businesses == [] do %>
        <p class="text-sm text-base-content/70">
          <%= if @may_create_business do %>
            You are not part of any business yet — create one above.
          <% else %>
            You’re not in any workspace yet. Open the invitation link from your email again after signing in, or ask your admin to resend it.
          <% end %>
        </p>
      <% else %>
        <div class="grid gap-4 lg:grid-cols-2 2xl:grid-cols-3">
        <%= for b <- @businesses do %>
          <div class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm space-y-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="font-medium text-base-content">{b.name}</p>
                <%= if RompCrm.Businesses.owner?(@user, b.id) do %>
                  <p class="text-xs text-base-content/60">
                    You are an owner — you can invite users.
                  </p>
                <% else %>
                  <p class="text-xs text-base-content/60">Member</p>
                <% end %>
              </div>
            </div>

            <%= if RompCrm.Businesses.owner?(@user, b.id) do %>
              <.form
                for={Map.fetch!(@invite_forms, b.id)}
                id={"invite-#{b.id}"}
                phx-change="validate_invite"
                phx-submit="invite"
                class="space-y-2"
              >
                <input type="hidden" name="invite[business_id]" value={b.id} />
                <.input
                  id={"invite-email-#{b.id}"}
                  field={Map.fetch!(@invite_forms, b.id)[:email]}
                  type="email"
                  label="Invite by email"
                  required
                />
                <.button class="btn btn-primary btn-sm" type="submit">Send invitation</.button>
              </.form>

              <% invites = Map.get(@invitation_lists, b.id, []) %>
              <%= if invites != [] do %>
                <div class="border-t border-base-300 pt-3 mt-2">
                  <p class="text-xs font-medium text-base-content/80 mb-2">Pending invitations</p>
                  <ul class="space-y-1">
                    <%= for inv <- invites do %>
                      <li class="flex items-center justify-between text-sm">
                        <span class="text-base-content">{inv.email}</span>
                        <button
                          type="button"
                          phx-click="cancel_invite"
                          phx-value-id={inv.id}
                          class="text-xs font-medium text-error hover:opacity-90"
                        >
                          Cancel
                        </button>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
        </div>
      <% end %>
      </div>
    </div>

    <p class="text-center">
      <.link navigate={~p"/"} class="link link-primary text-sm font-medium">← Back to jobs</.link>
    </p>
  </div>
</Layouts.app>
