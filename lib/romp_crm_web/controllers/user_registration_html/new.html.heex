<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm">
    <div class="text-center">
      <.header>
        Register for an account
        <:subtitle>
          <%= if @invitation_registration do %>
            You’re joining via a team invitation — no subscription needed.
          <% else %>
            Already registered?
            <.link navigate={~p"/users/log-in"} class="font-semibold text-brand hover:underline">
              Log in
            </.link>
            to your account now.
          <% end %>
        </:subtitle>
      </.header>
    </div>

    <%= if @invitation_registration do %>
      <div class="alert alert-info mb-4 text-sm" role="status">
        After you create your account, check your email for a sign-in link. Then you’ll finish joining the business you were invited to.
      </div>
    <% end %>

    <.form :let={f} for={@changeset} action={~p"/users/register"}>
      <.input
        field={f[:email]}
        type="email"
        label="Email"
        autocomplete="username"
        spellcheck="false"
        required
        phx-mounted={JS.focus()}
      />

      <%= if @subscription_paywall do %>
        <fieldset class="space-y-2 pt-2">
          <legend class="text-sm font-medium text-base-content">Billing plan</legend>
          <%= if @paypal_trial_days > 0 do %>
            <p class="text-xs text-base-content/70">
              {@paypal_trial_days}-day free trial — you’ll approve a PayPal subscription with a card on file.
              You are not charged the plan price until the trial ends. Cancel anytime during the trial in your PayPal
              account (Automatic payments) to avoid being charged.
            </p>
          <% else %>
            <p class="text-xs text-base-content/70">
              PayPal subscription approval is required before you receive your sign-in link.
            </p>
          <% end %>
          <label class="flex cursor-pointer items-center gap-2">
            <input type="radio" name="user[plan]" value="monthly" class="accent-brand" required />
            <span>Monthly ($25/mo after trial)</span>
          </label>
          <label class="flex cursor-pointer items-center gap-2">
            <input type="radio" name="user[plan]" value="annual" class="accent-brand" />
            <span>Annual ($240/yr after trial)</span>
          </label>
        </fieldset>
      <% end %>

      <.button phx-disable-with="Creating account..." class="btn btn-primary mt-4 w-full">
        Create an account
      </.button>
    </.form>
  </div>
</Layouts.app>
