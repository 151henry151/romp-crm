<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  show_workspace_nav={@show_workspace_nav}
  current_business_id={@current_business_id}
  my_businesses={@my_businesses}
  is_business_owner={@is_business_owner}
  content_width={:wide}
>
  <div class="text-center">
    <.header>
      Account Settings
      <:subtitle>Profile, email, password</:subtitle>
    </.header>
  </div>

  <%= if @show_paypal_subscription_help do %>
    <div class="mb-6 rounded-lg border border-base-300 bg-base-200/40 p-4 text-left text-sm text-base-content">
      <p class="font-semibold">Subscription billing (PayPal)</p>
      <%= if @paypal_trial_days > 0 do %>
        <p class="mt-2 text-base-content/80">
          {@paypal_trial_days}-day trial—cancel in PayPal before billing starts.
        </p>
      <% end %>
      <p class="mt-2 text-base-content/80">
        <a
          href="https://www.paypal.com/myaccount/autopay/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-brand hover:underline"
        >
          PayPal automatic payments
        </a>
      </p>
      <%= if @show_cancel_subscription do %>
        <div class="mt-4 border-t border-base-300 pt-4">
          <p class="font-semibold text-base-content">Cancel here</p>
          <p class="mt-1 text-base-content/80">
            Stops recurring billing (access until PayPal shows the period end).
          </p>
          <form action={~p"/users/settings"} method="post" class="mt-3">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <input type="hidden" name="_method" value="put" />
            <input type="hidden" name="action" value="cancel_subscription" />
            <button
              type="submit"
              class="btn btn-outline btn-error btn-sm"
              onclick="return confirm('Cancel subscription? Access continues through the end of your paid period.');"
            >
              Cancel subscription
            </button>
          </form>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="grid gap-10 xl:grid-cols-2 xl:items-start text-left">
  <section class="space-y-6">
  <.form :let={f} for={@profile_changeset} action={~p"/users/settings"} id="update_profile">
    <input type="hidden" name="action" value="update_profile" />

    <.input field={f[:phone]} type="tel" label="Your mobile number (SMS)" autocomplete="tel" />

    <p class="text-sm text-base-content/70 -mt-2 mb-4">
      Use the number you text from so inbound SMS matches your account. One mobile number can only be on
      <span class="font-medium text-base-content/90">one</span> Romp CRM account at a time. Remove it in the other
      account's Settings before you can use it here.
    </p>

    <%= if assigns[:profile_businesses] && length(@profile_businesses) > 1 do %>
      <.input
        field={f[:sms_business_id]}
        type="select"
        label="SMS workspace (if you belong to several)"
        prompt="Choose automatically"
        options={Enum.map(@profile_businesses, &{&1.name, &1.id})}
      />
    <% end %>

    <% prefs =
      RompCrm.Reminders.decode_prefs_json(
        Ecto.Changeset.get_field(@profile_changeset, :sms_reminder_prefs_json)
      ) %>
    <% offset_set = prefs["job_offsets"] |> List.wrap() |> MapSet.new() %>
    <% tz = Map.get(prefs, "timezone", "America/New_York") %>
    <% hour =
      case prefs["send_hour_local"] do
        h when is_integer(h) and h >= 0 and h <= 23 -> h
        _ -> 9
      end %>
    <div class="mt-6 rounded-lg border border-base-300 bg-base-200/30 p-4 text-left">
      <p class="font-semibold text-base-content mb-1">SMS reminders</p>
      <p class="text-sm text-base-content/70 mb-3">
        Job reminders: once daily at the hour below, in your time zone. Includes jobs with a schedule date and
        <span class="font-medium text-base-content/90">work items that have their own date</span> when it differs from the job (no duplicate if the dates match). Assistant reminders follow the same toggle.
      </p>
      <.input field={f[:sms_reminders_enabled]} type="checkbox" label="Send me SMS reminders" />

      <div class="mt-4">
        <label for="sms_reminder_timezone" class="mb-1 block text-sm font-medium text-base-content">
          Reminder time zone
        </label>
        <select
          id="sms_reminder_timezone"
          name="user[sms_reminder_timezone]"
          class="select select-bordered select-sm w-full max-w-md bg-base-100"
        >
          <%= for {label, value} <- RompCrm.Reminders.profile_timezone_select_options() do %>
            <option value={value} selected={value == tz}>{label}</option>
          <% end %>
        </select>
      </div>

      <fieldset class="mt-4 space-y-2 rounded-lg border border-base-300/70 bg-base-100/40 p-3">
        <legend class="mb-1 text-sm font-medium text-base-content">Remind me about upcoming jobs</legend>
        <p class="text-xs text-base-content/60 mb-2">
          Days relative to the job’s scheduled date.
        </p>
        <%= for {days, label} <- [
              {7, "1 week before"},
              {3, "3 days before"},
              {2, "2 days before"},
              {1, "1 day before"},
              {0, "Same day as the job"}
            ] do %>
          <label class="label cursor-pointer justify-start gap-3 py-1">
            <input
              type="checkbox"
              name="user[sms_reminder_offsets][]"
              value={days}
              checked={MapSet.member?(offset_set, days)}
              class="checkbox checkbox-sm"
            />
            <span class="label-text text-sm">{label}</span>
          </label>
        <% end %>
      </fieldset>

      <div class="mt-4">
        <label for="sms_reminder_send_hour_local" class="mb-1 block text-sm font-medium text-base-content">
          Send job reminders around this local hour
        </label>
        <select
          id="sms_reminder_send_hour_local"
          name="user[sms_reminder_send_hour_local]"
          class="select select-bordered select-sm w-full max-w-xs bg-base-100"
        >
          <%= for h <- 0..23 do %>
            <option value={h} selected={h == hour}>
              {String.pad_leading(Integer.to_string(h), 2, "0")}:00
            </option>
          <% end %>
        </select>
        <p class="mt-1 text-xs text-base-content/60">
          Uses the time zone above (DST applies automatically).
        </p>
      </div>
    </div>

    <.button variant="primary" phx-disable-with="Saving...">Save profile</.button>
  </.form>

  <div class="divider" />

  <h2 class="text-lg font-semibold text-base-content mb-1">Scheduling &amp; calendars</h2>
  <p class="text-sm text-base-content/70 mb-4">
    Used when clients book appointments through your booking links: open slots come from your
    working hours minus scheduled jobs, confirmed bookings, and busy times on any connected calendar.
    Only free/busy times are read — never event details. Your time zone is inferred from your phone
    number when you first use scheduling — change it below if needed.
  </p>

  <form action={~p"/users/settings/scheduling"} method="post" class="rounded-lg border border-base-300 bg-base-200/30 p-4 space-y-4">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input type="hidden" name="_method" value="put" />

    <div>
      <label for="sched_timezone" class="mb-1 block text-sm font-medium text-base-content">
        Scheduling time zone
      </label>
      <select
        id="sched_timezone"
        name="prefs[timezone]"
        class="select select-bordered select-sm w-full max-w-md bg-base-100"
      >
        <%= for {label, value} <- RompCrm.Reminders.profile_timezone_select_options() do %>
          <option value={value} selected={value == @scheduling_prefs.timezone}>{label}</option>
        <% end %>
      </select>
    </div>

    <div class="flex flex-wrap gap-4">
      <div>
        <label for="sched_start" class="mb-1 block text-sm font-medium text-base-content">Workday starts</label>
        <input
          id="sched_start"
          type="time"
          name="prefs[workday_start]"
          value={@scheduling_prefs.workday_start |> Time.to_iso8601() |> String.slice(0, 5)}
          class="input input-bordered input-sm bg-base-100"
        />
      </div>
      <div>
        <label for="sched_end" class="mb-1 block text-sm font-medium text-base-content">Workday ends</label>
        <input
          id="sched_end"
          type="time"
          name="prefs[workday_end]"
          value={@scheduling_prefs.workday_end |> Time.to_iso8601() |> String.slice(0, 5)}
          class="input input-bordered input-sm bg-base-100"
        />
      </div>
      <div>
        <label for="sched_buffer" class="mb-1 block text-sm font-medium text-base-content">Buffer between jobs</label>
        <select id="sched_buffer" name="prefs[buffer_minutes]" class="select select-bordered select-sm bg-base-100">
          <%= for {label, mins} <- [{"None", 0}, {"15 minutes", 15}, {"30 minutes", 30}, {"45 minutes", 45}, {"1 hour", 60}] do %>
            <option value={mins} selected={mins == @scheduling_prefs.buffer_minutes}>{label}</option>
          <% end %>
        </select>
      </div>
    </div>

    <div>
      <label for="sched_outreach" class="mb-1 block text-sm font-medium text-base-content">
        Customer outreach style
      </label>
      <select id="sched_outreach" name="prefs[customer_outreach_style]" class="select select-bordered select-sm w-full max-w-md bg-base-100">
        <%= for {label, value} <- [{"Ask what works for them", "ask"}, {"Offer specific times first", "offer"}, {"Offer times, invite alternatives", "offer_then_ask"}] do %>
          <option value={value} selected={value == @scheduling_prefs.customer_outreach_style}>{label}</option>
        <% end %>
      </select>
    </div>

    <div class="flex flex-wrap gap-4">
      <div>
        <label for="sched_min_lead" class="mb-1 block text-sm font-medium text-base-content">Minimum days notice</label>
        <input id="sched_min_lead" type="number" min="0" max="90" name="prefs[min_lead_days]" value={@scheduling_prefs.min_lead_days} class="input input-bordered input-sm w-24 bg-base-100" />
      </div>
      <div>
        <label for="sched_bias" class="mb-1 block text-sm font-medium text-base-content">Slot preference</label>
        <select id="sched_bias" name="prefs[scheduling_bias]" class="select select-bordered select-sm bg-base-100">
          <option value="" selected={is_nil(@scheduling_prefs.scheduling_bias)}>Default</option>
          <option value="asap" selected={@scheduling_prefs.scheduling_bias == "asap"}>Soonest available</option>
          <option value="spread" selected={@scheduling_prefs.scheduling_bias == "spread"}>Spread across days</option>
        </select>
      </div>
    </div>

    <fieldset class="space-y-1">
      <legend class="mb-1 text-sm font-medium text-base-content">Work days</legend>
      <div class="flex flex-wrap gap-3">
        <%= for {label, day} <- [{"Mon", 1}, {"Tue", 2}, {"Wed", 3}, {"Thu", 4}, {"Fri", 5}, {"Sat", 6}, {"Sun", 7}] do %>
          <label class="label cursor-pointer justify-start gap-1.5 py-0">
            <input
              type="checkbox"
              name="prefs[work_days][]"
              value={day}
              checked={day in @scheduling_prefs.work_days}
              class="checkbox checkbox-sm"
            />
            <span class="label-text text-sm">{label}</span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <button type="submit" class="btn btn-brand btn-sm">Save scheduling preferences</button>
  </form>

  <div class="mt-4 rounded-lg border border-base-300 bg-base-200/30 p-4 space-y-3">
    <p class="font-semibold text-base-content">Scheduling playbook</p>
    <p class="text-sm text-base-content/70">
      Rules learned from your SMS setup or preference updates (greetings, confirm-before-offer, custom instructions).
      Text the assistant anytime to change how scheduling works — or remove rules here.
    </p>
    <%= if @scheduling_playbook_rules == [] do %>
      <p class="text-sm text-base-content/60">No custom playbook rules yet.</p>
    <% else %>
      <ul class="space-y-2">
        <%= for rule <- @scheduling_playbook_rules do %>
          <li class="flex flex-wrap items-start justify-between gap-2 rounded-lg border border-base-300/70 bg-base-100/50 p-3 text-sm">
            <div>
              <p class="font-medium text-base-content">{rule.kind}</p>
              <%= if rule.source_text do %>
                <p class="mt-1 text-base-content/75">{rule.source_text}</p>
              <% end %>
            </div>
            <form action={~p"/users/settings/scheduling/playbook/#{rule.id}/deactivate"} method="post">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <button type="submit" class="btn btn-ghost btn-xs">Remove</button>
            </form>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="mt-4 rounded-lg border border-base-300 bg-base-200/30 p-4">
    <p class="text-sm font-medium text-base-content">Scheduling agent preview</p>
    <p class="mt-1 text-sm text-base-content/70">
      Try out an interaction with your scheduling agent to see what the client experience will be like — without creating real jobs or texting real customers.
    </p>
    <a href={~p"/scheduling-agent-test"} class="btn btn-outline btn-sm mt-3">
      Test scheduling agent
    </a>
  </div>

  <% google_cred = Enum.find(@calendar_credentials, &(&1.source == "google")) %>
  <% apple_cred = Enum.find(@calendar_credentials, &(&1.source == "apple")) %>

  <div class="rounded-lg border border-base-300 bg-base-200/30 p-4 space-y-4">
    <p class="font-semibold text-base-content">Connected calendars</p>

    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="text-sm font-medium text-base-content">Google Calendar</p>
        <%= if google_cred do %>
          <p class="text-xs text-base-content/60">
            <%= if google_cred.status == "error" do %>
              Connection error — reconnect below. <span class="text-error">{google_cred.last_sync_error}</span>
            <% else %>
              Connected<%= if google_cred.last_synced_at do %>, last checked {Calendar.strftime(google_cred.last_synced_at, "%b %-d, %H:%M UTC")}<% end %>.
            <% end %>
          </p>
        <% else %>
          <p class="text-xs text-base-content/60">Not connected.</p>
        <% end %>
      </div>
      <div class="flex gap-2">
        <%= if @google_calendar_configured do %>
          <a href={~p"/users/settings/calendars/google/connect"} class="btn btn-outline btn-sm">
            {if google_cred, do: "Reconnect", else: "Connect Google"}
          </a>
        <% else %>
          <span class="text-xs text-base-content/50">Not available on this server yet.</span>
        <% end %>
        <%= if google_cred do %>
          <form action={~p"/users/settings/calendars/google/disconnect"} method="post">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit" class="btn btn-ghost btn-sm text-error">Disconnect</button>
          </form>
        <% end %>
      </div>
    </div>

    <div class="border-t border-base-300/70 pt-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <p class="text-sm font-medium text-base-content">Apple Calendar (iCloud)</p>
          <%= if apple_cred do %>
            <p class="text-xs text-base-content/60">
              <%= if apple_cred.status == "error" do %>
                Connection error — re-enter your app-specific password below.
              <% else %>
                Connected<%= if apple_cred.last_synced_at do %>, last checked {Calendar.strftime(apple_cred.last_synced_at, "%b %-d, %H:%M UTC")}<% end %>.
              <% end %>
            </p>
          <% else %>
            <p class="text-xs text-base-content/60">Not connected.</p>
          <% end %>
        </div>
        <%= if apple_cred do %>
          <form action={~p"/users/settings/calendars/apple/disconnect"} method="post">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit" class="btn btn-ghost btn-sm text-error">Disconnect</button>
          </form>
        <% end %>
      </div>

      <form action={~p"/users/settings/calendars/apple"} method="post" class="mt-3 space-y-2">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <p class="text-xs text-base-content/60">
          Sign in with your Apple ID and an
          <a
            href="https://support.apple.com/102654"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-brand hover:underline"
          >app-specific password</a>
          (not your main Apple password). Generate one at appleid.apple.com under Sign-In &amp; Security.
        </p>
        <div class="flex flex-wrap gap-2">
          <input
            type="email"
            name="apple[apple_id]"
            placeholder="you@icloud.com"
            autocomplete="off"
            class="input input-bordered input-sm bg-base-100"
          />
          <input
            type="password"
            name="apple[app_password]"
            placeholder="xxxx-xxxx-xxxx-xxxx"
            autocomplete="off"
            class="input input-bordered input-sm bg-base-100"
          />
          <button type="submit" class="btn btn-outline btn-sm">
            {if apple_cred, do: "Update Apple connection", else: "Connect Apple"}
          </button>
        </div>
      </form>
    </div>
  </div>
  </section>

  <section class="space-y-6" id="print-reports">
  <h2 class="text-lg font-semibold text-base-content mb-1">Print reports (PDF)</h2>
  <p class="text-sm text-base-content/70 mb-4">
    Download a PDF for an activity report (date range) or a full customer list.
    Owner workspaces only—same selection rules as CSV export. Works on phone and desktop;
    no print dialog required.
  </p>

  <form
    action={~p"/users/settings/reports"}
    method="post"
    id="print_reports"
    class="mt-4 space-y-3"
  >
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <fieldset class="rounded-lg border border-base-300 bg-base-200/30 p-3 space-y-2">
      <legend class="text-sm font-medium text-base-content px-1">Workspaces to include</legend>
      <%= if @owned_businesses_for_export == [] do %>
        <p class="text-sm text-base-content/70">
          No owned workspace yet—create one under Jobs first.
        </p>
      <% else %>
        <%= for biz <- @owned_businesses_for_export do %>
          <label class="flex cursor-pointer items-start gap-2 text-sm">
            <input
              type="checkbox"
              name="export_business_ids[]"
              value={biz.id}
              checked={biz.id in @export_selected_business_ids}
              class="checkbox checkbox-sm mt-0.5"
            />
            <span class="font-medium">{biz.name}</span>
          </label>
        <% end %>
      <% end %>
    </fieldset>

    <fieldset class="rounded-lg border border-base-300 bg-base-200/30 p-3 space-y-2">
      <legend class="text-sm font-medium text-base-content px-1">Report type</legend>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input
          type="radio"
          name="report_type"
          value="activity"
          checked
          class="radio radio-sm mt-0.5"
        />
        <span>
          <span class="font-medium">Activity report</span>
          — job hours, clock punches, new leads, jobs worked on, plus all open (not completed) leads and jobs
        </span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input type="radio" name="report_type" value="customers" class="radio radio-sm mt-0.5" />
        <span>
          <span class="font-medium">Customer list</span>
          — name, phone, email, addresses, notes, linked job count
        </span>
      </label>
    </fieldset>

    <fieldset class="rounded-lg border border-base-300 bg-base-200/30 p-3 space-y-2">
      <legend class="text-sm font-medium text-base-content px-1">Date range (activity report)</legend>
      <div class="flex flex-wrap items-end gap-3">
        <label class="form-control w-auto">
          <span class="label py-0"><span class="label-text text-xs">From</span></span>
          <input
            type="date"
            name="from_date"
            value={Date.utc_today() |> then(&%{&1 | day: 1}) |> Date.to_iso8601()}
            class="input input-bordered input-sm bg-base-100"
          />
        </label>
        <label class="form-control w-auto">
          <span class="label py-0"><span class="label-text text-xs">To</span></span>
          <input
            type="date"
            name="to_date"
            value={Date.to_iso8601(Date.utc_today())}
            class="input input-bordered input-sm bg-base-100"
          />
        </label>
      </div>
    </fieldset>

    <button type="submit" class="btn btn-primary btn-sm" disabled={@owned_businesses_for_export == []}>
      Download PDF
    </button>
  </form>
  </section>

  <section class="space-y-6">
  <h2 class="text-lg font-semibold text-base-content mb-1">Data export (CSV)</h2>
  <p class="text-sm text-base-content/70 mb-4">
    Owner workspaces only (not invited-only memberships).
    <span class="font-medium text-base-content/90">Jobs</span>,
    <span class="font-medium text-base-content/90">Clients</span>,
    <span class="font-medium text-base-content/90">Employees</span>,
    <span class="font-medium text-base-content/90">Time log</span>,
    <span class="font-medium text-base-content/90">Audit log</span> (who changed what, web + SMS).
    Job photos are <span class="font-medium text-base-content/90">not</span> included in CSV email exports (too large for attachments)—export them separately below.
  </p>

  <.form
    :let={f}
    for={@export_changeset}
    action={~p"/users/settings"}
    method="post"
    id="data_export"
    class="mt-4 space-y-3"
  >
    <input type="hidden" name="_method" value="put" />

    <fieldset class="rounded-lg border border-base-300 bg-base-200/30 p-3 space-y-2">
      <legend class="text-sm font-medium text-base-content px-1">Workspaces to include</legend>
      <%= if @owned_businesses_for_export == [] do %>
        <p class="text-sm text-base-content/70">
          No owned workspace yet—create one under Jobs first.
        </p>
      <% else %>
        <%= for biz <- @owned_businesses_for_export do %>
          <label class="flex cursor-pointer items-start gap-2 text-sm">
            <input
              type="checkbox"
              name="export_business_ids[]"
              value={biz.id}
              checked={biz.id in @export_selected_business_ids}
              class="checkbox checkbox-sm mt-0.5"
            />
            <span class="font-medium">{biz.name}</span>
          </label>
        <% end %>
      <% end %>
    </fieldset>

    <fieldset class="rounded-lg border border-base-300 bg-base-200/30 p-3 space-y-2">
      <legend class="text-sm font-medium text-base-content px-1">Tables to include</legend>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input
          type="checkbox"
          name="export_kinds[]"
          value="jobs"
          checked={"jobs" in @export_selected_kind_strings}
          class="checkbox checkbox-sm mt-0.5"
        />
        <span><span class="font-medium">Jobs</span> — jobs.csv</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input
          type="checkbox"
          name="export_kinds[]"
          value="clients"
          checked={"clients" in @export_selected_kind_strings}
          class="checkbox checkbox-sm mt-0.5"
        />
        <span><span class="font-medium">Clients</span> — clients.csv</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input
          type="checkbox"
          name="export_kinds[]"
          value="employees"
          checked={"employees" in @export_selected_kind_strings}
          class="checkbox checkbox-sm mt-0.5"
        />
        <span><span class="font-medium">Employees</span> — employees.csv</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input
          type="checkbox"
          name="export_kinds[]"
          value="time_log"
          checked={"time_log" in @export_selected_kind_strings}
          class="checkbox checkbox-sm mt-0.5"
        />
        <span><span class="font-medium">Time log</span> — clocks</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input
          type="checkbox"
          name="export_kinds[]"
          value="audit_log"
          checked={"audit_log" in @export_selected_kind_strings}
          class="checkbox checkbox-sm mt-0.5"
        />
        <span><span class="font-medium">Audit log</span> — web + SMS changes</span>
      </label>
    </fieldset>

    <.input
      field={f[:data_export_schedule]}
      type="select"
      label="Automatic export schedule"
      options={[
        {"Off", "none"},
        {"Daily", "daily"},
        {"Weekly", "weekly"},
        {"Monthly", "monthly"}
      ]}
    />

    <p class="text-xs text-base-content/60 mb-1">
      Scheduled sends use the selections above (UTC cadence from last success).
      <span class="font-semibold">Save export preferences</span> stores schedule + checkboxes.
    </p>

    <div class="flex flex-wrap items-center gap-2">
      <button type="submit" name="action" value="update_data_export_schedule" class="btn btn-brand btn-sm">
        Save export preferences
      </button>
      <button type="submit" name="action" value="export_email_now" class="btn btn-outline btn-sm">
        Email selected to me
      </button>
      <button type="submit" name="action" value="export_download" class="btn btn-outline btn-sm">
        Download selected
      </button>
      <span class="text-sm text-base-content/70">
        Owner businesses: {length(@owned_businesses_for_export)}
      </span>
    </div>
    <p class="text-xs text-base-content/60">
      Download: one CSV or a ZIP if multiple tables. Email with 3+ tables: one ZIP.
    </p>

    <fieldset class="rounded-lg border border-base-300 bg-base-200/30 p-3 space-y-2">
      <legend class="text-sm font-medium text-base-content px-1">Job photos</legend>
      <p class="text-xs text-base-content/70">
        Uses the workspace checkboxes above. Downloads a ZIP with one folder per job that has photos.
      </p>
      <button type="submit" name="action" value="export_photos_download" class="btn btn-outline btn-sm">
        Download all photos (ZIP)
      </button>
    </fieldset>
  </.form>

  <div class="divider" />

  <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
    <input type="hidden" name="action" value="update_email" />

    <.input
      field={f[:email]}
      type="email"
      label="Email"
      autocomplete="username"
      spellcheck="false"
      required
    />

    <.button variant="primary" phx-disable-with="Changing...">Change Email</.button>
  </.form>

  <div class="divider" />

  <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
    <input type="hidden" name="action" value="update_password" />

    <.input
      field={f[:password]}
      type="password"
      label="New password"
      autocomplete="new-password"
      spellcheck="false"
      required
    />
    <.input
      field={f[:password_confirmation]}
      type="password"
      label="Confirm new password"
      autocomplete="new-password"
      spellcheck="false"
      required
    />
    <.button variant="primary" phx-disable-with="Changing...">
      Save Password
    </.button>
  </.form>
  </section>
  </div>
</Layouts.app>
