<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  show_workspace_nav={@show_workspace_nav}
  current_business_id={@current_business_id}
  my_businesses={@my_businesses}
  is_business_owner={@is_business_owner}
>
  <div class="text-center">
    <.header>
      Account Settings
      <:subtitle>Manage your profile, email address, and password</:subtitle>
    </.header>
  </div>

  <%= if @show_paypal_subscription_help do %>
    <div class="mx-auto max-w-lg mb-6 rounded-lg border border-base-300 bg-base-200/40 p-4 text-left text-sm text-base-content">
      <p class="font-semibold">Subscription billing (PayPal)</p>
      <%= if @paypal_trial_days > 0 do %>
        <p class="mt-2 text-base-content/80">
          You have a {@paypal_trial_days}-day trial period before recurring billing begins. To cancel before you are
          charged for the plan, turn off or cancel this agreement in PayPal before the trial ends.
        </p>
      <% end %>
      <p class="mt-2 text-base-content/80">
        Manage or cancel automatic payments in your PayPal account:
      </p>
      <p class="mt-2">
        <a
          href="https://www.paypal.com/myaccount/autopay/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-brand hover:underline"
        >
          Open PayPal automatic payments
        </a>
      </p>
      <%= if @show_cancel_subscription do %>
        <div class="mt-4 border-t border-base-300 pt-4">
          <p class="font-semibold text-base-content">Cancel from Romp CRM</p>
          <p class="mt-1 text-base-content/80">
            End recurring billing here — you don’t need to hunt through PayPal’s menus.
          </p>
          <form action={~p"/users/settings"} method="post" class="mt-3">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <input type="hidden" name="_method" value="put" />
            <input type="hidden" name="action" value="cancel_subscription" />
            <button
              type="submit"
              class="btn btn-outline btn-error btn-sm"
              onclick="return confirm('Cancel your Romp CRM subscription in PayPal? You keep access through the end of the period PayPal shows for your plan. This cannot be undone from here.');"
            >
              Cancel subscription
            </button>
          </form>
        </div>
      <% end %>
    </div>
  <% end %>

  <.form :let={f} for={@profile_changeset} action={~p"/users/settings"} id="update_profile">
    <input type="hidden" name="action" value="update_profile" />

    <.input field={f[:phone]} type="tel" label="Your mobile number (SMS)" autocomplete="tel" />

    <p class="text-sm text-base-content/70 -mt-2 mb-4">
      Set this to the same number you text from so inbound SMS routes to the correct workspace.
    </p>

    <%= if assigns[:profile_businesses] && length(@profile_businesses) > 1 do %>
      <.input
        field={f[:sms_business_id]}
        type="select"
        label="SMS workspace (when you belong to several businesses)"
        prompt="Choose automatically"
        options={Enum.map(@profile_businesses, &{&1.name, &1.id})}
      />
    <% end %>

    <div class="mt-6 rounded-lg border border-base-300 bg-base-200/30 p-4 text-left">
      <p class="font-semibold text-base-content mb-1">SMS reminders</p>
      <p class="text-sm text-base-content/70 mb-3">
        Opt in to texts about upcoming jobs (from each job’s scheduled date) and one-off reminders you create by messaging the assistant.
        Preferences are a JSON object: <code class="text-xs">job_offsets</code> lists how many days before the job date to ping (for example
        <code class="text-xs">[1,0]</code> means the day before and the day of). <code class="text-xs">send_hour_utc</code> is the UTC hour (0–23) when job pings may be sent.
      </p>
      <.input field={f[:sms_reminders_enabled]} type="checkbox" label="Send me SMS reminders" />
      <.input
        field={f[:sms_reminder_prefs_json]}
        type="textarea"
        label="Reminder preferences (JSON, optional)"
        placeholder='{"job_offsets":[1,0],"send_hour_utc":13}'
      />
    </div>

    <.button variant="primary" phx-disable-with="Saving...">Save profile</.button>
  </.form>

  <div class="divider" />

  <h2 class="text-lg font-semibold text-base-content mb-1">Data export (CSV)</h2>
  <p class="text-sm text-base-content/70 mb-4 max-w-lg mx-auto text-left">
    Choose which workspaces and which tables to include. Only businesses you <span class="font-semibold">created</span> (owner) appear here. Workspaces where you are only a member or invitee are never included.
    <span class="font-medium text-base-content/90">Jobs</span> (jobs.csv),
    <span class="font-medium text-base-content/90">Employees</span> (employees.csv),
    <span class="font-medium text-base-content/90">Time log</span> (job clocks and employee clocks),
    <span class="font-medium text-base-content/90">Audit log</span> (business-scoped changes from the web UI and SMS, with which user made each change).
  </p>

  <.form :let={f} for={@export_changeset} action={~p"/users/settings"} method="post" id="update_data_export_schedule">
    <input type="hidden" name="_method" value="put" />
    <input type="hidden" name="action" value="update_data_export_schedule" />

    <.input
      field={f[:data_export_schedule]}
      type="select"
      label="Automatic export schedule"
      options={[
        {"Off", "none"},
        {"Daily", "daily"},
        {"Weekly", "weekly"},
        {"Monthly", "monthly"}
      ]}
    />

    <p class="text-xs text-base-content/60 mb-3 max-w-lg mx-auto text-left">
      When enabled, the server emails you on each interval (counted in UTC from the last successful send). Scheduled runs always include all four CSVs and all workspaces you own. For a one-off, use the buttons below and pick workspaces and files.
    </p>

    <.button variant="primary" phx-disable-with="Saving...">Save schedule</.button>
  </.form>

  <form action={~p"/users/settings"} method="post" class="mt-4 max-w-lg mx-auto text-left space-y-3">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input type="hidden" name="_method" value="put" />

    <fieldset class="rounded-lg border border-base-300 bg-base-200/30 p-3 space-y-2">
      <legend class="text-sm font-medium text-base-content px-1">Workspaces to include</legend>
      <%= if @owned_businesses_for_export == [] do %>
        <p class="text-sm text-base-content/70">
          You do not own any workspaces yet — create one under Jobs to export data.
        </p>
      <% else %>
        <%= for biz <- @owned_businesses_for_export do %>
          <label class="flex cursor-pointer items-start gap-2 text-sm">
            <input
              type="checkbox"
              name="export_business_ids[]"
              value={biz.id}
              checked
              class="checkbox checkbox-sm mt-0.5"
            />
            <span class="font-medium">{biz.name}</span>
          </label>
        <% end %>
      <% end %>
    </fieldset>

    <fieldset class="rounded-lg border border-base-300 bg-base-200/30 p-3 space-y-2">
      <legend class="text-sm font-medium text-base-content px-1">Tables to include</legend>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input type="checkbox" name="export_kinds[]" value="jobs" checked class="checkbox checkbox-sm mt-0.5" />
        <span><span class="font-medium">Jobs</span> — jobs.csv</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input type="checkbox" name="export_kinds[]" value="employees" checked class="checkbox checkbox-sm mt-0.5" />
        <span><span class="font-medium">Employees</span> — employees.csv</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input type="checkbox" name="export_kinds[]" value="time_log" checked class="checkbox checkbox-sm mt-0.5" />
        <span><span class="font-medium">Time log</span> — time_log.csv</span>
      </label>
      <label class="flex cursor-pointer items-start gap-2 text-sm">
        <input type="checkbox" name="export_kinds[]" value="audit_log" checked class="checkbox checkbox-sm mt-0.5" />
        <span><span class="font-medium">Audit log</span> — audit_log.csv</span>
      </label>
    </fieldset>

    <div class="flex flex-wrap items-center gap-2">
      <button type="submit" name="action" value="export_email_now" class="btn btn-outline btn-sm">
        Email selected to me
      </button>
      <button type="submit" name="action" value="export_download" class="btn btn-outline btn-sm">
        Download selected
      </button>
      <span class="text-sm text-base-content/70">
        Owner businesses: {length(@owned_businesses_for_export)}
      </span>
    </div>
    <p class="text-xs text-base-content/60">
      One CSV downloads as that file. If you pick more than one table, you get a single <code class="text-xs">.zip</code> containing the selected CSVs. Rows are limited to the workspaces checked above.
    </p>
  </form>

  <div class="divider" />

  <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
    <input type="hidden" name="action" value="update_email" />

    <.input
      field={f[:email]}
      type="email"
      label="Email"
      autocomplete="username"
      spellcheck="false"
      required
    />

    <.button variant="primary" phx-disable-with="Changing...">Change Email</.button>
  </.form>

  <div class="divider" />

  <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
    <input type="hidden" name="action" value="update_password" />

    <.input
      field={f[:password]}
      type="password"
      label="New password"
      autocomplete="new-password"
      spellcheck="false"
      required
    />
    <.input
      field={f[:password_confirmation]}
      type="password"
      label="Confirm new password"
      autocomplete="new-password"
      spellcheck="false"
      required
    />
    <.button variant="primary" phx-disable-with="Changing...">
      Save Password
    </.button>
  </.form>
</Layouts.app>
