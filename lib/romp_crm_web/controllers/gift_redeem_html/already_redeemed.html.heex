<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-md space-y-4 text-center text-base-content">
    <.header>Gift already redeemed</.header>
    <p class="text-sm text-base-content/80">This subscription gift was already used.</p>
    <.link navigate={~p"/"} class="btn btn-brand btn-sm">Go to Romp CRM</.link>
  </div>
</Layouts.app>
