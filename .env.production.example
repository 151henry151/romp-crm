# Copy to `.env.production` on the server (not committed). Used by systemd EnvironmentFile.
#
# Elixir 1.18+ lives at ~/.local/elixir-v1.18.4-otp-25/bin — optional system PATH for interactive shells.

MIX_ENV=prod
PHX_SERVER=true

# Listen address for nginx reverse-proxy (match nginx proxy_pass port).
PORT=40175

# Public URL (magic links, redirects).
PHX_HOST=hromp.com

# Optional comma-separated list of allowed WebSocket origins (https://…). If set, this
# list is used alone (for self-host or staging). If unset, runtime allows `PHX_HOST`
# (apex + www) plus the public Romp CRM hostnames (hromp.com and rompcrm.com, each apex + www).
# PHX_CHECK_ORIGINS=https://crm.example.com,https://www.crm.example.com

# Mount path without leading slash (nginx location prefix).
PHX_PATH=romp-crm

# openssl rand -base64 48   OR   mix phx.gen.secret
SECRET_KEY_BASE=

# SQLite file (persistent).
DATABASE_PATH=/home/henry/romp-crm/data/romp_crm.db

# Email “From” (confirm envelope + SPF/DMARC for your domain).
MAIL_FROM_NAME="Romp CRM"
MAIL_FROM_ADDRESS=crm@hromp.com

# SMTP (production uses mail.spacemail.com — match host to your provider).
# Use the submission hostname (not an IP). Runtime enables no_mx_lookups so TLS matches the cert.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=587
SMTP_TLS=always
SMTP_USERNAME=crm@hromp.com
SMTP_PASSWORD=
