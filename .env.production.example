# Copy to `.env.production` on the server (not committed). Used by systemd EnvironmentFile.
#
# Elixir 1.18+ lives at ~/.local/elixir-v1.18.4-otp-25/bin — optional system PATH for interactive shells.

MIX_ENV=prod
PHX_SERVER=true

# Listen address for nginx reverse-proxy (match nginx proxy_pass port).
PORT=40175

# Public URL (magic links, redirects).
PHX_HOST=hromp.com

# Mount path without leading slash (same pattern as Bitcoinex Explorer /btcexp).
PHX_PATH=jgs-crm

# openssl rand -base64 48   OR   mix phx.gen.secret
SECRET_KEY_BASE=

# SQLite file (persistent).
DATABASE_PATH=/home/henry/jgs-crm/data/jgs_crm.db

# Email “From” (confirm envelope + SPF/DMARC for your domain).
MAIL_FROM_NAME="JGS CRM"
MAIL_FROM_ADDRESS=

# SMTP (same stack as other apps often use Gmail SMTP + app password).
# Debian needs `erlang-xmerl` for compile; runtime uses Swoosh SMTP adapter.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=always
SMTP_USERNAME=
SMTP_PASSWORD=
